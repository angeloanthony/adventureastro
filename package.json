{
  "name": "adventuretoursvernal",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "npm run gates:src && astro build && npm run gates:dist",
    "validate": "npm run gates:src && npm run gates:dist",
    "gates:src": "node scripts/gate-4j-gallery-parity.mjs",
    "gates:dist": "node scripts/validate-site.mjs && node scripts/gate-4k-direction.mjs && node scripts/gate-4f-headings.mjs && node scripts/gate-4h-seams.mjs && node scripts/gate-4i-glossary.mjs && node scripts/gate-4g-anchors.mjs",
    "census:phrases": "node scripts/census/phrase-set.mjs > census/phrase-set.json",
    "census:phrase-count": "node scripts/census/phrase-count.mjs --phrases census/phrase-set.json --out census/phrase-count.json --measured-at",
    "gate:4j": "node scripts/gate-4j-gallery-parity.mjs",
    "gate:4f": "node scripts/gate-4f-headings.mjs",
    "gate:4g": "node scripts/gate-4g-anchors.mjs",
    "gate:4h": "node scripts/gate-4h-seams.mjs",
    "gate:4i": "node scripts/gate-4i-glossary.mjs",
    "gate:4k": "node scripts/gate-4k-direction.mjs",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/mdx": "^6.0.3",
    "@astrojs/sitemap": "^3.7.0",
    "astro": "^6.4.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3"
  }
}
