---
// BaseLayout.astro — the single page shell for every page (Build Guide
// §3.1). Owns <html>/<head>/<body> so that pillar/spoke/tour/etc. layouts
// — and pages still on the legacy set:html pattern — can place the real
// Header/Footer components as siblings around their content without
// mismatched <body> tags.
//
// Each page passes its <head> content through the `head` slot (title,
// meta, canonical, OG/Twitter, schema) and its body content through the
// `body` slot — Header/Footer components plus, on not-yet-refactored
// legacy pages, a `set:html` fragment for the remaining inline markup.
//
// `bodyClass` lets a page carry a page-level body class forward (e.g.
// legacy pages that styled `body.policy-page-body` for a background
// treatment) now that BaseLayout, not the page, owns the <body> tag.
//
// `assets` (default true) makes BaseLayout emit the shared, byte-identical
// head assets that used to be duplicated in every page's headHtml — the
// Google Fonts preconnect/stylesheet, the site stylesheet, and the three
// favicon links (Build Guide §3.1, deduplication). Pages pass only their
// page-specific <Seo>/schema through the head slot. 404.astro opts out
// (assets={false}) because it deliberately keeps its own root-relative
// asset paths.
//
// P1 MULTILINGUAL INFRA (existence-aware, inert while only English exists):
//   • lang/dir derive from the URL (or an explicit `lang` prop). English →
//     `<html lang="en">` with no dir attribute, byte-identical to before.
//   • hreflang alternates emit ONLY when a page has >1 locale with content.
//     Today getAvailableLocales() returns ['en'] for every page, so nothing
//     is emitted and the head is unchanged. It goes live automatically when
//     localized content is committed — no edit here required.
import {
  getLangFromUrl, isRtl, getAvailableLocales, getLocaleMeta,
  localizedPath, DEFAULT_LOCALE, LOCALE_CODES,
} from '../lib/i18n';
import { absoluteUrl } from '../lib/urls';
interface Props {
  bodyClass?: string;
  assets?: boolean;
  /** Override the auto-detected locale (defaults to URL-derived). */
  lang?: string;
  /** Normalized page slug for hreflang alternates (defaults to URL-derived). */
  slug?: string;
  /** Locales that have content for this page (defaults to existence check). */
  availableLocales?: string[];
}
const { bodyClass, assets = true, lang: langProp, slug, availableLocales } = Astro.props;
const lang = langProp ?? getLangFromUrl(Astro.url);
const dir = isRtl(lang) ? 'rtl' : undefined;
const pageSlug = slug ?? (() => {
  const segs = Astro.url.pathname.split('/').filter(Boolean);
  if (segs[0] && segs[0] !== DEFAULT_LOCALE && (LOCALE_CODES as readonly string[]).includes(segs[0])) segs.shift();
  return segs.join('/');
})();
const available: string[] = availableLocales ?? getAvailableLocales(pageSlug);
const showHreflang = available.length > 1;
---
<!DOCTYPE html>
<html lang={lang} dir={dir}>
<head>
  <slot name="head" />
  {showHreflang && available.map((code) => (
    <link rel="alternate" hreflang={getLocaleMeta(code).hreflang} href={absoluteUrl(localizedPath(pageSlug, code))} />
  ))}
  {showHreflang && (
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(localizedPath(pageSlug, DEFAULT_LOCALE))} />
  )}
  {assets && (
    <Fragment>
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Open+Sans:wght@400;600;700&display=swap" rel="stylesheet" />
      <link rel="stylesheet" href="/styles.css" />
      <link rel="icon" href="/images/logo2.ico" sizes="any" />
      <link rel="icon" type="image/svg+xml" href="/images/favicon.svg" />
      <link rel="icon" type="image/webp" href="/images/logo1.webp" />
    </Fragment>
  )}
  <!-- Google tag (gtag.js) -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-MVCDESQ5GN"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());

    gtag('config', 'G-MVCDESQ5GN');
  </script>
  <!--
    Conversion instrumentation — see docs/perf/V0-analytics-contract.md.

    ONE DELEGATED LISTENER, MATCHING ON href. Not a handler per CTA: there are 1,801 phone
    links and 3,082 booking links rendered from .astro components, page-content locale blocks
    and MDX bodies, and a per-element approach would be re-broken by the next author to add a
    button. Delegation means any anchor to /booking/ is instrumented the moment it renders.

    href IS THE DISCRIMINATOR BECAUSE CLASS IS NOT. Measured in dist/: `cta-phone` (40),
    `cta-button primary` (25) and `tour-book-btn` (16) all carry tel: links. A class-based
    selector would file those 16 as bookings, and the error would be invisible — it would
    look like more bookings than there were.

    NO VIDEO EVENTS HERE. `video_start`/`video_progress` are GA4 enhanced-measurement names;
    sending custom events under them merges two schemas irreversibly. The facade sets
    `enablejsapi=1` and lets GA4 collect them natively instead.
  -->
  <script is:inline>
    (function () {
      var BOOKING = /^\/(?:[a-z]{2}\/)?booking\/$/;
      // Measured in dist/, not assumed: 3,082 booking affordances are anchors, but 57 are
      // <button onclick> — 49 navigating via location.href and 8 opening cal.com, which is a
      // SECOND booking funnel with no /booking/ path at all. An anchor-only listener would
      // have reported a clean, complete-looking booking number that silently excluded both.
      var CALCOM = /(?:^|\.)cal\.com$/;
      var NAV = /(?:location\.href\s*=\s*|window\.open\s*\(\s*)['"]([^'"]+)['"]/;

      var isBooking = function (url) {
        return BOOKING.test(url.pathname) || CALCOM.test(url.hostname);
      };
      var resolve = function (raw) {
        try { return new URL(raw, location.href); } catch (err) { return null; }
      };
      var send = function (url) {
        gtag('event', 'booking_click', {
          page_path: location.pathname,
          locale: document.documentElement.lang || '',
          // Same-origin destinations report a path; cal.com reports its full URL, because
          // "which funnel" is the distinction that matters and a bare path would hide it.
          destination: url.origin === location.origin ? url.pathname : url.href,
        });
      };

      document.addEventListener('click', function (e) {
        if (!e.target || !e.target.closest) return;

        var a = e.target.closest('a[href]');
        if (a) {
          var raw = a.getAttribute('href') || '';
          if (raw.slice(0, 4).toLowerCase() === 'tel:') {
            gtag('event', 'phone_click', {
              page_path: location.pathname,
              locale: document.documentElement.lang || '',
              phone: raw.slice(4),
            });
            return;
          }
          // Resolve before matching: the contract is about where the click GOES, not how the
          // href was spelled.
          var u = resolve(a.href);
          if (u && isBooking(u)) send(u);
          return;
        }

        // Navigation expressed as an inline handler. Only a destination this pattern can
        // actually read is considered, and only if it is a booking destination — so the
        // carousel and accordion buttons that also carry onclick are untouched.
        var el = e.target.closest('[onclick]');
        if (!el) return;
        var m = NAV.exec(el.getAttribute('onclick') || '');
        if (!m) return;
        var nu = resolve(m[1]);
        if (nu && isBooking(nu)) send(nu);
      });
    })();
  </script>
</head>
<body class={bodyClass}>
  <slot name="body" />
</body>
</html>
