---
// CityLayout.astro — city landing page shell (Build Guide §4.3,
// 1,500-2,500 words). Reads structured facts off a `cities` collection
// entry; the drive-by-drive prose and FAQ are supplied via the default
// slot. City page rule (§4.3): minimum 40% unique content per city —
// this layout only provides the scaffolding, not the words.
import BaseLayout from './BaseLayout.astro';
import Seo from '../components/seo/Seo.astro';
import SchemaLocalBusiness from '../components/seo/SchemaLocalBusiness.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import QuickFacts from '../components/content/QuickFacts.astro';
import TourCta from '../components/content/TourCta.astro';
import { getLangFromUrl, localeHref } from '../lib/i18n';
import { t, hubName } from '../lib/ui';
import type { CollectionEntry } from 'astro:content';

// Active authority hubs to cross-link from every city page (Build Guide
// §4.3 "Hub" integration). Hand-picked, not HUB_SLUGS, because several
// registered hubs (atv, jeep, hiking, camping, fishing, scenic-drives)
// have no pillar page yet — linking them would be a dead/empty-section
// link (Task 3's "without exposing empty sections" rule applies here too).
const ACTIVE_HUBS = ['utv', 'things-to-do', 'dinosaur-national-monument', 'guides'] as const;

interface RelatedLink { title: string; description: string; href: string }

interface Props {
  title: string;
  description: string;
  path: string;
  heroImage?: string;
  breadcrumbs: { label: string; href?: string }[];
  city: CollectionEntry<'cities'>['data'];
  /** Localized override for the English-only `routeSummary` collection field.
   *  The `cities` collection is English-only by design (P3D), so a localized
   *  page passes its own route sentence here; road numbers and place names
   *  stay English per the frozen never-translate list. */
  routeSummary?: string;
  /** ⚠ THIS OVERRIDE EXISTS BECAUSE THE COMMENT ABOVE USED TO SAY IT WAS UNNECESSARY.
   *
   *  The original claim was: "`nearestAirport` needs no override — an airport's official name
   *  is a proper noun in every locale's shipped prose." That is true of the NAME and false of
   *  the STRING, and the difference only becomes visible in an RTL locale.
   *
   *  `QuickFacts` renders each value as a bare `<dd>{value}</dd>` with no isolation, and the
   *  shipped English value ends in a parenthetical — `Salt Lake City International Airport
   *  (SLC)`. In an RTL page that closing bracket sits between a Latin run and the paragraph
   *  direction, which is ADR-10's invariant exactly. Measured before any Arabic prose existed,
   *  by injecting the value alone into a built `ar` page: gate 4n reports
   *  `")" in <dd> flanked L … R` and EXITS 1. It is a build blocker, not an advisory.
   *
   *  Authoring cannot reach it — the string is in the collection, not the page — so the fix has
   *  to be a prop, and it mirrors `routeSummary` exactly. Every locale that does not pass it
   *  keeps `city.nearestAirport` byte-for-byte, so this adds a capability and changes no
   *  existing output. An assumption that held for eight locales expired at the RTL boundary;
   *  same shape as the two recorded in AR2-PhaseF-plan.md §3. */
  nearestAirport?: string;
  /** Curated links to relevant existing spokes/pillars — every city page
   *  supplies its own (RelatedArticles isn't reusable here: cities aren't
   *  a hub collection, so there's no tag-matching entry to key off). */
  relatedLinks?: RelatedLink[];
}
const { title, description, path, heroImage, breadcrumbs, city, routeSummary, nearestAirport, relatedLinks = [] } = Astro.props;
const lang = getLangFromUrl(Astro.url);

const quickFacts = [
  { label: t('city.driveTime', lang), value: t('city.driveTimeValue', lang, { n: city.driveTimeHours }) },
  { label: t('city.distance', lang), value: t('city.distanceValue', lang, { n: city.driveMiles }) },
  { label: t('city.route', lang), value: routeSummary ?? city.routeSummary },
  ...(nearestAirport ?? city.nearestAirport ? [{ label: t('city.nearestAirport', lang), value: nearestAirport ?? city.nearestAirport }] : []),
];
---
<BaseLayout>
  <Fragment slot="head">
    <Seo title={title} description={description} path={path} image={heroImage} />
    <SchemaLocalBusiness />
  </Fragment>
  <Fragment slot="body">
    <Header />
    <Breadcrumbs items={breadcrumbs} />
    <main class="city-page">
      <QuickFacts facts={quickFacts} />
      <slot />
      <TourCta variant="family" />

      <section class="hub-index" aria-label={t('section.exploreVernal', lang)}>
        <h2 class="hub-index-heading">{t('section.exploreVernal', lang)}</h2>
        <ul class="hub-index-list">
          {ACTIVE_HUBS.map((hub) => (
            <li class="hub-index-item">
              <a href={localeHref(hub, lang)}>{hubName(hub, lang)}</a>
            </li>
          ))}
        </ul>
      </section>

      {relatedLinks.length > 0 && (
        <section class="related-articles" aria-label={t('a11y.relatedGuides', lang)}>
          <h2 class="related-articles-heading">{t('section.moreVernalGuides', lang)}</h2>
          <div class="related-grid">
            {relatedLinks.map((link) => (
              <a href={link.href} class="related-card">
                <h3>{link.title}</h3>
                <p>{link.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </main>
    <Footer />
  </Fragment>
</BaseLayout>
