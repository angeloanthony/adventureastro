---
// CityLayout.astro — city landing page shell (Build Guide §4.3,
// 1,500-2,500 words). Reads structured facts off a `cities` collection
// entry; the drive-by-drive prose and FAQ are supplied via the default
// slot. City page rule (§4.3): minimum 40% unique content per city —
// this layout only provides the scaffolding, not the words.
import BaseLayout from './BaseLayout.astro';
import Seo from '../components/seo/Seo.astro';
import SchemaLocalBusiness from '../components/seo/SchemaLocalBusiness.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import QuickFacts from '../components/content/QuickFacts.astro';
import TourCta from '../components/content/TourCta.astro';
import { HUBS, pillarHref } from '../lib/hubs';
import type { CollectionEntry } from 'astro:content';

// Active authority hubs to cross-link from every city page (Build Guide
// §4.3 "Hub" integration). Hand-picked, not HUB_SLUGS, because several
// registered hubs (atv, jeep, hiking, camping, fishing, scenic-drives)
// have no pillar page yet — linking them would be a dead/empty-section
// link (Task 3's "without exposing empty sections" rule applies here too).
const ACTIVE_HUBS = ['utv', 'things-to-do', 'dinosaur-national-monument', 'guides'] as const;

interface RelatedLink { title: string; description: string; href: string }

interface Props {
  title: string;
  description: string;
  path: string;
  heroImage?: string;
  breadcrumbs: { label: string; href?: string }[];
  city: CollectionEntry<'cities'>['data'];
  /** Curated links to relevant existing spokes/pillars — every city page
   *  supplies its own (RelatedArticles isn't reusable here: cities aren't
   *  a hub collection, so there's no tag-matching entry to key off). */
  relatedLinks?: RelatedLink[];
}
const { title, description, path, heroImage, breadcrumbs, city, relatedLinks = [] } = Astro.props;

const quickFacts = [
  { label: 'Drive time', value: `${city.driveTimeHours} hours` },
  { label: 'Distance', value: `${city.driveMiles} miles` },
  { label: 'Route', value: city.routeSummary },
  ...(city.nearestAirport ? [{ label: 'Nearest airport', value: city.nearestAirport }] : []),
];
---
<BaseLayout>
  <Fragment slot="head">
    <Seo title={title} description={description} path={path} image={heroImage} />
    <SchemaLocalBusiness />
  </Fragment>
  <Fragment slot="body">
    <Header />
    <Breadcrumbs items={breadcrumbs} />
    <main class="city-page">
      <QuickFacts facts={quickFacts} />
      <slot />
      <TourCta variant="family" />

      <section class="hub-index" aria-label="Explore Vernal">
        <h2 class="hub-index-heading">Explore Vernal</h2>
        <ul class="hub-index-list">
          {ACTIVE_HUBS.map((hub) => (
            <li class="hub-index-item">
              <a href={pillarHref(hub)}>{HUBS[hub].name}</a>
            </li>
          ))}
        </ul>
      </section>

      {relatedLinks.length > 0 && (
        <section class="related-articles" aria-label="Related guides">
          <h2 class="related-articles-heading">More Vernal Guides</h2>
          <div class="related-grid">
            {relatedLinks.map((link) => (
              <a href={link.href} class="related-card">
                <h3>{link.title}</h3>
                <p>{link.description}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </main>
    <Footer />
  </Fragment>
</BaseLayout>
