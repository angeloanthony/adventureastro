---
// ItineraryLayout.astro — itinerary-spoke shell (Planning Authority cluster).
// Itinerary articles render with the SAME editorial pattern as the Hiking,
// Camping, Fishing, and Scenic-Drive spokes, so this layout adds no markup of
// its own: it delegates entirely to SpokeLayout with the collection pinned to
// 'itineraries'. That reuses one code path for Seo, SchemaLocalBusiness,
// Article + FAQPage + Breadcrumb schema, Header/Breadcrumbs/Footer,
// FaqAccordion, TourCta, AuthorByline, and RelatedArticles (manual `related`
// overrides + shared-tag matching). The page body — H1, prose, and the hidden
// AI-summary block — is authored in the MDX and passed through the slot.
import SpokeLayout from './SpokeLayout.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  heroImage: string;
  author: 'dave' | 'trudy';
  publishDate: Date;
  updatedDate: Date;
  breadcrumbs: { label: string; href?: string }[];
  currentId: string;
  tags?: string[];
  related?: string[];
  tourCta?: 'utv' | 'private' | 'sunset' | 'none';
  faq?: { q: string; a: string }[];
  ogTitle?: string;
  ogDescription?: string;
}
const props = Astro.props;
---
<SpokeLayout {...props} collection="itineraries">
  <slot />
</SpokeLayout>
