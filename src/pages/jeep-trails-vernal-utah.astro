---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Seo from '../components/seo/Seo.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { bodyHtml } from '../page-content/jeep-trails';
import { getLangFromUrl } from '../lib/i18n';
import { t } from '../lib/ui';
const lang = getLangFromUrl(Astro.url);
// Article + FAQ structured data preserved verbatim from the legacy head.
const schema = `{"@context":"https://schema.org","@graph":[{"@type":"Article","headline":"Jeep Trails Near Vernal, Utah","description":"Guide to Jeep and off-road trails near Vernal, Utah, including backcountry routes and guided UTV tour options.","author":{"@type":"Organization","name":"Adventure Tours Vernal"},"publisher":{"@type":"Organization","name":"Adventure Tours Vernal","logo":{"@type":"ImageObject","url":"https://adventuretoursvernal.com/images/logo.webp"}},"datePublished":"2026-04-08","dateModified":"2026-04-08","mainEntityOfPage":"https://adventuretoursvernal.com/jeep-trails-vernal-utah/"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Are there Jeep trails near Vernal, Utah?","acceptedAnswer":{"@type":"Answer","text":"Yes. The BLM land and backcountry surrounding Vernal has extensive off-road routes suitable for Jeeps and 4x4 vehicles, plus five guided UTV trail systems accessible through Adventure Tours Vernal."}},{"@type":"Question","name":"Can I do a guided off-road tour instead of driving my own Jeep?","acceptedAnswer":{"@type":"Answer","text":"Yes. Adventure Tours Vernal offers guided Kawasaki KRX 1000 UTV tours across five trail systems with expert guides, so you don't need your own vehicle. $349 per machine for 3 hours."}},{"@type":"Question","name":"How does Vernal compare to Moab for off-roading?","acceptedAnswer":{"@type":"Answer","text":"Vernal offers similar canyon and desert terrain with significantly fewer crowds. The trails are less commercialized, the backcountry is more remote, and guided tour pricing is competitive with or better than Moab operators."}}]}]}`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="Jeep Trails Near Vernal, Utah | Off-Road & UTV Trail Guide"
      description="Jeep trails and off-road routes near Vernal, Utah. Explore backcountry canyons, desert terrain, and historic trails by Jeep or guided Kawasaki KRX 1000 UTV tour."
      path="/jeep-trails-vernal-utah/"
      type="article"
      ogTitle="Jeep Trails Near Vernal, Utah | Off-Road Guide"
      ogDescription="Off-road trails near Vernal for Jeeps, 4x4s, and guided UTV tours through canyon country and backcountry terrain."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.trails', lang), href: '/utv/' }, { label: 'Jeep Trails' }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer slot="body" variant="compact" />
</BaseLayout>
