---
// pt/privacy-policy.astro — Portuguese privacy policy (P7-P6 inline batch).
// Mirrors src/pages/fr/privacy-policy.astro.
import { getBodyHtml } from '../../page-content/privacy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../../lib/i18n';
import { t } from '../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
---
<BaseLayout bodyClass="policy-page-body">
  <Fragment slot="head">
    <Seo
      title="Política de Privacidade | Adventure Tours Vernal"
      description="Política de privacidade da Adventure Tours Vernal em Vernal, Utah: como recolhemos, usamos e protegemos as tuas informações. Liga para (435) 219-9447."
      path="/pt/privacy-policy/"
      type="website"
      ogDescription="Como a Adventure Tours Vernal recolhe, usa e protege as tuas informações quando reservas um tour guiado em UTV em Vernal, Utah."
    />
  </Fragment>
  <Header slot="body" active="privacy-policy" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.privacyPolicy', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.quickLinks', lang),
      links: [
        { href: '/pt/utv/', label: t('footer.link.ourTours', lang) },
        { href: '/pt/#vehicles', label: t('footer.link.ourFleet', lang) },
        { href: '/pt/#gallery', label: t('footer.link.photoGallery', lang) },
        { href: '/pt/booking/', label: t('cta.bookNow', lang) },
      ],
    }}
    contact={{ showStreet: false }}
    info={{
      heading: t('footer.information', lang),
      links: [
        { href: '/pt/cancellation-policy/', label: t('nav.cancellationPolicy', lang) },
        { href: '/pt/privacy-policy/', label: t('nav.privacyPolicy', lang) },
        { href: '/pt/faq/', label: t('nav.faq', lang) },
        { href: '/pt/safety-guidelines/', label: t('nav.safetyGuidelines', lang) },
      ],
    }}
  />
</BaseLayout>
