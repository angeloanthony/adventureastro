---
// pt/utv/index.astro — Portuguese UTV landing page (P7-P6 batch, informal
// "tu" register). Mirrors src/pages/fr/utv/index.astro structurally, which
// in turn mirrors src/pages/utv/index.astro.
//
// The Portuguese UTV spoke articles (all 7) already exist as translated MDX
// by the time this pillar lands — so HubIndex's `utv` collection read will
// surface Portuguese titles/links here once locale is 'pt', with no change
// needed to HubIndex itself.
import { getBodyHtml } from '../../../page-content/utv';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../config/site';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Seo from '../../../components/seo/Seo.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import HubIndex from '../../../components/content/HubIndex.astro';
import TourDecisionGuide from '../../../components/content/TourDecisionGuide.astro';
import { getLangFromUrl } from '../../../lib/i18n';
import { t } from '../../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
const schema = `
  {
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "name": "Tours de Trilhos UTV — Adventure Tours Vernal",
    "description": "Tours guiados de UTV perto de Vernal, Utah. Os trilhos incluem Doc's Beach, Moonshine Arch, Ashley Gorge, Outlaw Trail e Asphalt Ridge. Petróglifos, fauna selvagem incluindo águias-reais, águias-de-cabeça-branca, veados e pumas, e vastos miradouros panorâmicos.",
    "url": "https://adventuretoursvernal.com/pt/utv/",
    "image": "https://adventuretoursvernal.com/images/Docs%20Beach.webp",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Adventure Tours Vernal",
      "telephone": "+1-435-219-9447",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1935 S 1500 E",
        "addressLocality": "Vernal",
        "addressRegion": "UT",
        "postalCode": "84078",
        "addressCountry": "US"
      }
    }
  }
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="Tours de Trilhos UTV em Vernal, Utah | Adventure Tours Vernal"
      description="Explora tours guiados de UTV Kawasaki KRX 1000 perto de Vernal, Utah — Doc's Beach, Moonshine Arch, Ashley Gorge, Outlaw Trail e Asphalt Ridge. Liga (435) 219-9447."
      path="/pt/utv/"
      type="website"
      image="https://adventuretoursvernal.com/images/Docs%20Beach.webp"
      ogTitle="Tours de Trilhos UTV | Adventure Tours Vernal"
      ogDescription="Cinco tours guiados de trilhos UTV perto de Vernal, Utah. Águias, petróglifos, canyons e paisagens de tirar o fôlego. Liga (435) 219-9447."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="trails" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.trails', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <TourDecisionGuide slot="body" />
  <HubIndex slot="body" collection="utv" heading="Todos os Guias de Trilhos UTV" />
  <Footer
    slot="body"
    trails={{
      heading: 'Os Nossos Trilhos',
      links: [
        { href: '/pt/utv/', label: "Doc's Beach" },
        { href: '/pt/utv/', label: 'Moonshine Arch' },
        { href: '/pt/utv/', label: 'Ashley Gorge' },
        { href: '/pt/utv/', label: 'Outlaw Trail' },
        { href: '/pt/utv/', label: 'Asphalt Ridge' },
      ],
    }}
    contact={{ heading: 'Contacto' }}
  />
</BaseLayout>
