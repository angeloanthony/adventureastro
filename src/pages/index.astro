---
import { bodyHtml } from "../page-content/home";
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Seo from '../components/seo/Seo.astro';
import { SITE } from '../config/site';
import { getLangFromUrl } from '../lib/i18n';
import { t } from '../lib/ui';
const lang = getLangFromUrl(Astro.url);
// TouristInformationCenter + OfferCatalog structured data preserved verbatim
// from the legacy head (no pricing fields — page pricing lives in the body).
const schema = `
  {
    "@context": "https://schema.org",
    "@type": "TouristInformationCenter",
    "name": "Adventure Tours Vernal",
    "image": "https://adventuretoursvernal.com/images/logo.webp",
    "telephone": "+1-435-219-9447",
    "email": "adventuretoursvernal@gmail.com",
    "url": "https://adventuretoursvernal.com",
    "priceRange": "$$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1935 S 1500 E",
      "addressLocality": "Vernal",
      "addressRegion": "UT",
      "postalCode": "84078",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 40.4555,
      "longitude": -109.5287
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"
      ],
      "opens": "07:00",
      "closes": "19:00"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "reviewCount": "82",
      "bestRating": "5",
      "worstRating": "1"
    },
    "employee": {
      "@type": "Person",
      "name": "Dave Wilson",
      "jobTitle": "Lead Guide & Owner",
      "description": "Dave Wilson is the owner and lead guide of Adventure Tours Vernal, a locally owned UTV tour company serving the Uintah Basin. Dave brings deep knowledge of Vernal's backcountry trails, Dinosaur National Monument, and Utah's high desert terrain.",
      "url": "https://adventuretoursvernal.com/about/"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Guided UTV & Side-by-Side Trail Tours — Vernal, Utah",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Doc's Beach UTV Tour",
            "description": "Guided side-by-side adventure to Doc's Beach, featuring off-road trails, sandy desert terrain, and sweeping views of the Uintah Basin near Vernal, Utah.",
            "provider": { "@type": "LocalBusiness", "name": "Adventure Tours Vernal" },
            "areaServed": "Vernal, Utah"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Moonshine Arch UTV Tour",
            "description": "Guided Kawasaki KRX 1000 tour to Moonshine Arch, winding through Utah's red rock canyons and high desert plateaus near Vernal, Utah.",
            "provider": { "@type": "LocalBusiness", "name": "Adventure Tours Vernal" },
            "areaServed": "Vernal, Utah"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Ashley Gorge UTV Tour",
            "description": "Guided side-by-side tour through the dramatic Ashley Gorge canyon corridor, with towering sandstone walls and river valley scenery near Vernal, Utah.",
            "provider": { "@type": "LocalBusiness", "name": "Adventure Tours Vernal" },
            "areaServed": "Vernal, Utah"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Outlaw Trail UTV Tour",
            "description": "Guided backcountry UTV tour following Utah's historic Outlaw Trail through rugged canyon terrain used by Butch Cassidy's Wild Bunch near Vernal, Utah.",
            "provider": { "@type": "LocalBusiness", "name": "Adventure Tours Vernal" },
            "areaServed": "Vernal, Utah"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Asphalt Ridge UTV Tour",
            "description": "Guided Kawasaki KRX 1000 ridge-top tour along Asphalt Ridge with panoramic views of Dinosaur Country and the Uintah Mountains near Vernal, Utah.",
            "provider": { "@type": "LocalBusiness", "name": "Adventure Tours Vernal" },
            "areaServed": "Vernal, Utah"
          }
        }
      ]
    }
  }
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="Guided UTV Tours in Vernal, Utah | Adventure Tours Vernal"
      description="Adventure Tours Vernal offers guided Kawasaki KRX 1000 side-by-side tours through Utah's Dinosaur Country. 5-star rated. Open daily 7am–7pm. Call (435) 219-9447."
      path=""
      type="website"
      ogTitle="Adventure Tours Vernal | Guided UTV Tours in Utah's Dinosaur Country"
      ogDescription="Guided Kawasaki KRX 1000 side-by-side tours through Vernal's backcountry. 5.0 stars, 82 reviews. Call (435) 219-9447."
      twitterTitle="Adventure Tours Vernal | Guided UTV Tours in Utah"
      twitterDescription="Guided Kawasaki KRX 1000 side-by-side tours through Vernal's backcountry. 5.0 stars, 82 reviews."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="home" />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.ourTrails', lang),
      links: [
        { href: '#tours', label: "Doc's Beach" },
        { href: '#tours', label: 'Moonshine Arch' },
        { href: '#tours', label: 'Ashley Gorge' },
        { href: '#tours', label: 'Outlaw Trail' },
        { href: '#tours', label: 'Asphalt Ridge' },
        { href: '/booking/', label: t('cta.bookNow', lang), class: 'nav-book-btn' },
      ],
    }}
    contact={{ emailAsLink: true }}
    info={{
      heading: t('footer.information', lang),
      links: [
        { href: '/cancellation-policy/', label: t('nav.cancellationPolicy', lang) },
        { href: '/privacy-policy/', label: t('nav.privacyPolicy', lang) },
        { href: '/faq/', label: t('nav.faq', lang) },
        { href: '/safety-guidelines/', label: t('nav.safetyGuidelines', lang) },
        { href: '/guides/what-to-bring/', label: t('nav.whatToBring', lang) },
      ],
      secondHeading: t('section.exploreVernal', lang),
      secondLinks: [
        { href: '/utv/', label: t('footer.link.utvTrailsTours', lang) },
        { href: '/things-to-do/', label: t('footer.link.thingsToDo', lang) },
        { href: '/dinosaur-national-monument/', label: t('footer.link.dinosaurNationalMonument', lang) },
        { href: '/guides/', label: t('footer.link.guides', lang) },
        { href: '/from/salt-lake-city/', label: t('footer.link.visitingFromSLC', lang) },
      ],
    }}
  />
</BaseLayout>
