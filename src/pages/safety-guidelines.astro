---
import { bodyHtml } from '../page-content/safety';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Seo from '../components/seo/Seo.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../lib/i18n';
import { t } from '../lib/ui';
const lang = getLangFromUrl(Astro.url);
---
<BaseLayout bodyClass="policy-page-body">
  <Fragment slot="head">
    <Seo
      title="Safety Guidelines | Adventure Tours Vernal — Vernal, Utah"
      description="Safety guidelines for guided UTV tours in Vernal, Utah. Age requirements, vehicle operation rules, trail safety, and emergency procedures. Call (435) 219-9447."
      path="/safety-guidelines/"
      type="website"
      ogTitle="Safety Guidelines | Adventure Tours Vernal"
      ogDescription="Review safety guidelines for guided Kawasaki KRX 1000 UTV tours in Vernal, Utah. Age limits, vehicle rules, trail safety, and what to expect. Call (435) 219-9447."
    />
  </Fragment>
  <Header slot="body" active="safety-guidelines" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.safetyGuidelines', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.quickLinks', lang),
      links: [
        { href: '/#tours', label: t('footer.link.ourTours', lang) },
        { href: '/#vehicles', label: t('footer.link.ourFleet', lang) },
        { href: '/#gallery', label: t('footer.link.photoGallery', lang) },
        { href: '/booking/', label: t('cta.bookNow', lang) },
      ],
    }}
  />
</BaseLayout>
