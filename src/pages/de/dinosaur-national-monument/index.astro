---
// de/dinosaur-national-monument/index.astro — German DNM hub pillar
// (P9 German inline batch, mirrors Portuguese P7-P6 / src/pages/pt/dinosaur-national-monument/index.astro).
// German spoke articles for this hub already exist (visiting-dinosaur-national-monument,
// petroglyphs-rock-art-vernal — see DE_SLUGS in src/lib/i18n.ts), so HubIndex renders
// German titles/links directly, matching the Italian/Spanish/Portuguese/French rollout pattern.
import { getBodyHtml } from '../../../page-content/dnm';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../config/site';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Seo from '../../../components/seo/Seo.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import HubIndex from '../../../components/content/HubIndex.astro';
import { getLangFromUrl } from '../../../lib/i18n';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
const schema = `{"@context":"https://schema.org","@graph":[{"@type":"Article","headline":"UTV-Touren in der Nähe des Dinosaur National Monument","description":"Geführte UTV-Touren im Backcountry rund um das Dinosaur National Monument, Vernal, Utah.","author":{"@type":"Organization","name":"Adventure Tours Vernal"},"publisher":{"@type":"Organization","name":"Adventure Tours Vernal","logo":{"@type":"ImageObject","url":"https://adventuretoursvernal.com/images/logo.webp"}},"datePublished":"2026-04-08","dateModified":"2026-04-08","mainEntityOfPage":"https://adventuretoursvernal.com/de/dinosaur-national-monument/"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Gibt es UTV-Touren in der Nähe des Dinosaur National Monument?","acceptedAnswer":{"@type":"Answer","text":"Ja. Adventure Tours Vernal bietet geführte Touren mit Kawasaki KRX 1000 im Backcountry rund um das Monument. Motorisierte Fahrzeuge sind innerhalb des Monuments nicht erlaubt, aber die Pisten direkt davor zeigen dasselbe Canyon-Gelände, dieselben Petroglyphen und geologischen Formationen."}},{"@type":"Question","name":"Wie weit ist Adventure Tours Vernal vom Dinosaur National Monument entfernt?","acceptedAnswer":{"@type":"Answer","text":"Adventure Tours Vernal hat seinen Sitz in Vernal, Utah, etwa 20 Minuten westlich der Quarry Exhibit Hall des Monuments. Viele Besucher kombinieren eine UTV-Tour mit einem Monument-Besuch auf derselben Reise."}},{"@type":"Question","name":"Wie kombiniert man eine UTV-Tour am besten mit dem Dinosaur National Monument?","acceptedAnswer":{"@type":"Answer","text":"Buche deine UTV-Tour für den Vormittag und besuche das Monument am Nachmittag, oder umgekehrt. Eine 3-stündige geführte UTV-Tour plus ein halber Tag am Monument ergeben einen vollen Tag Abenteuer im Land der Canyons."}}]}]}`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="UTV-Touren nahe Dinosaur National Monument | Adventure Tours"
      description="Geführte UTV-Touren nahe Dinosaur National Monument in Vernal, Utah. Canyons, Petroglyphen und Wüste nur Minuten vom Monument entfernt. Jetzt buchen."
      path="/de/dinosaur-national-monument/"
      type="article"
      ogTitle="UTV-Touren nahe Dinosaur National Monument"
      ogDescription="Geführte Kawasaki-KRX-1000-Touren im Backcountry rund um das Dinosaur National Monument — Canyons, Petroglyphen und Wüstenabenteuer."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="dinosaur-national-monument" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: 'Touren zum Dinosaurier-Monument' }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <HubIndex slot="body" collection="dinosaur-national-monument" heading="Alle Guides zum Dinosaurier-Monument" />
  <Footer slot="body" variant="compact" />
</BaseLayout>
