---
// de/utv/index.astro — German UTV landing page (P9A batch, informal "du"
// register). Mirrors src/pages/pt/utv/index.astro structurally, which in
// turn mirrors src/pages/utv/index.astro.
//
// The German UTV spoke articles (all 7) already exist as translated MDX
// by the time this pillar lands (see DE_SLUGS in src/lib/i18n.ts) — so
// HubIndex's `utv` collection read will surface German titles/links here
// once locale is 'de', with no change needed to HubIndex itself.
import { getBodyHtml } from '../../../page-content/utv';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../config/site';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Seo from '../../../components/seo/Seo.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import HubIndex from '../../../components/content/HubIndex.astro';
import TourDecisionGuide from '../../../components/content/TourDecisionGuide.astro';
import { getLangFromUrl } from '../../../lib/i18n';
import { t } from '../../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
const schema = `
  {
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "name": "UTV-Pistentouren — Adventure Tours Vernal",
    "description": "Geführte UTV-Touren in der Nähe von Vernal, Utah. Die Pisten umfassen Doc's Beach, Moonshine Arch, Ashley Gorge, Outlaw Trail und Asphalt Ridge. Petroglyphen, Wildtiere wie Steinadler, Weißkopfseeadler, Hirsche und Pumas, sowie weite Panoramablicke.",
    "url": "https://adventuretoursvernal.com/de/utv/",
    "image": "https://adventuretoursvernal.com/images/Docs%20Beach.webp",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Adventure Tours Vernal",
      "telephone": "+1-435-219-9447",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1935 S 1500 E",
        "addressLocality": "Vernal",
        "addressRegion": "UT",
        "postalCode": "84078",
        "addressCountry": "US"
      }
    }
  }
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="UTV-Pistentouren in Vernal, Utah | Adventure Tours Vernal"
      description="Entdecke geführte UTV-Touren mit dem Kawasaki KRX 1000 in der Nähe von Vernal, Utah — Doc's Beach, Moonshine Arch, Ashley Gorge. Ruf an: (435) 219-9447."
      path="/de/utv/"
      type="website"
      image="https://adventuretoursvernal.com/images/Docs%20Beach.webp"
      ogTitle="UTV-Pistentouren | Adventure Tours Vernal"
      ogDescription="Fünf geführte UTV-Pistentouren in der Nähe von Vernal, Utah. Adler, Petroglyphen, Canyons und atemberaubende Landschaften. Ruf an unter (435) 219-9447."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="trails" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.trails', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <TourDecisionGuide slot="body" />
  <HubIndex slot="body" collection="utv" heading="Alle UTV-Pisten-Guides" />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.ourTrails', lang),
      links: [
        { href: '/de/utv/', label: "Doc's Beach" },
        { href: '/de/utv/', label: 'Moonshine Arch' },
        { href: '/de/utv/', label: 'Ashley Gorge' },
        { href: '/de/utv/', label: 'Outlaw Trail' },
        { href: '/de/utv/', label: 'Asphalt Ridge' },
      ],
    }}
    contact={{ heading: 'Kontakt' }}
  />
</BaseLayout>
