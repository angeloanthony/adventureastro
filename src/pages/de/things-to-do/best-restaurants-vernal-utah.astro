const restaurantListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Von Adventure Tours Vernal Empfohlene Restaurants in Vernal, Utah',
  itemListElement: restaurants.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
