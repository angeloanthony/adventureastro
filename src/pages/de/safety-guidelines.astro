---
// de/safety-guidelines.astro — German safety guidelines (P9 German inline
// batch, mirrors Portuguese P7-P6 / French P8-P6). Mirrors
// src/pages/safety-guidelines.astro.
import { getBodyHtml } from '../../page-content/safety';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../../lib/i18n';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
---
<BaseLayout bodyClass="policy-page-body">
  <Fragment slot="head">
    <Seo
      title="Sicherheitshinweise | Adventure Tours Vernal — Vernal, Utah"
      description="Sicherheitshinweise für UTV-Touren in Vernal, Utah: Mindestalter, Fahrzeugregeln, Sicherheit auf der Piste und Notfallverfahren. Ruf an: (435) 219-9447."
      path="/de/safety-guidelines/"
      type="website"
      ogTitle="Sicherheitshinweise | Adventure Tours Vernal"
      ogDescription="Sieh dir die Sicherheitshinweise für UTV-Kawasaki-KRX-1000-Touren in Vernal, Utah an: Altersgrenzen, Fahrzeugregeln und Pistensicherheit. Ruf an: (435) 219-9447."
    />
  </Fragment>
  <Header slot="body" active="safety-guidelines" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: 'Sicherheitshinweise' }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: 'Schnellzugriff',
      links: [
        { href: '/de/utv/', label: 'Unsere Touren' },
        { href: '/de/#vehicles', label: 'Unsere Fahrzeugflotte' },
        { href: '/de/#gallery', label: 'Fotogalerie' },
        { href: '/de/booking/', label: 'Jetzt Buchen' },
      ],
    }}
  />
</BaseLayout>
