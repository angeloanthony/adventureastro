const lang = getLangFromUrl(Astro.url);

const schema = `{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": "Der Ultimative Guide zu Panoramastraßen im Land der Dinosaurier",
        "description": "Der Plan eines Local-Guides, um die beste Panoramastraße bei Vernal, Utah, und im ganzen Land der Dinosaurier zu wählen — die Flaming Gorge–Uintas Scenic Byway, den Red Cloud Loop, die Sheep Creek Geological Loop, die Cub Creek Road und die Panoramastraßen des Dinosaur National Monument — passend zu deiner Zeit, der Jahreszeit, deinen Interessen und deinem Fahrzeug.",
        "author": {"@type": "Organization", "name": "Adventure Tours Vernal"},
        "publisher": {"@type": "Organization", "name": "Adventure Tours Vernal", "logo": {"@type": "ImageObject", "url": "https://adventuretoursvernal.com/images/logo.webp"}},
        "datePublished": "2026-07-11",
        "dateModified": "2026-07-11",
