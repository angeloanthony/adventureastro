---
// de/cancellation-policy.astro — German cancellation policy (P9-inline
// batch). Mirrors src/pages/fr/cancellation-policy.astro.
import { getBodyHtml } from '../../page-content/cancellation';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../../lib/i18n';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
---
<BaseLayout bodyClass="policy-page-body">
  <Fragment slot="head">
    <Seo
      title="Stornierungsbedingungen | Adventure Tours Vernal — Vernal, Utah"
      description="Storno- und Erstattungsbedingungen von Adventure Tours Vernal für geführte UTV-Touren in Vernal, Utah. 72+ Stunden = volle Erstattung. Ruf an: (435) 219-9447."
      path="/de/cancellation-policy/"
      type="website"
      ogTitle="Stornierungsbedingungen | Adventure Tours Vernal"
      ogDescription="Lies unsere Stornierungsbedingungen für geführte UTV-Touren in Vernal, Utah. Volle Erstattung bei 72+ Stunden Vorlauf. Ruf an: (435) 219-9447."
    />
  </Fragment>
  <Header slot="body" active="cancellation-policy" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: 'Stornierungsbedingungen' }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: 'Schnellzugriff',
      links: [
        { href: '/de/#tours', label: 'Unsere Touren' },
        { href: '/de/#vehicles', label: 'Unsere Fahrzeugflotte' },
        { href: '/de/#gallery', label: 'Fotogalerie' },
        { href: '/de/booking/', label: 'Jetzt Buchen' },
      ],
    }}
  />
</BaseLayout>
