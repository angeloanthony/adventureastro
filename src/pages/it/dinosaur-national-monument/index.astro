---
// it/dinosaur-national-monument/index.astro — Italian DNM hub pillar
// (P6 Italian inline batch, mirrors Spanish P3B / src/pages/es/dinosaur-national-monument/index.astro).
// Italian spoke articles for this hub already exist (visiting-dinosaur-national-monument,
// petroglyphs-rock-art-vernal — see IT_SLUGS in src/lib/i18n.ts), so HubIndex renders
// Italian titles/links directly, unlike the Spanish rollout's existence-aware English fallback.
import { getBodyHtml } from '../../../page-content/dnm';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../config/site';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Seo from '../../../components/seo/Seo.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import HubIndex from '../../../components/content/HubIndex.astro';
import { getLangFromUrl } from '../../../lib/i18n';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
const schema = `{"@context":"https://schema.org","@graph":[{"@type":"Article","headline":"Tour UTV Vicino a Dinosaur National Monument","description":"Tour guidati in UTV nel backcountry che circonda Dinosaur National Monument, Vernal, Utah.","author":{"@type":"Organization","name":"Adventure Tours Vernal"},"publisher":{"@type":"Organization","name":"Adventure Tours Vernal","logo":{"@type":"ImageObject","url":"https://adventuretoursvernal.com/images/logo.webp"}},"datePublished":"2026-04-08","dateModified":"2026-04-08","mainEntityOfPage":"https://adventuretoursvernal.com/it/dinosaur-national-monument/"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"È possibile fare tour in UTV vicino a Dinosaur National Monument?","acceptedAnswer":{"@type":"Answer","text":"Sì. Adventure Tours Vernal organizza tour guidati in Kawasaki KRX 1000 nel backcountry che circonda il monumento. Anche se i veicoli motorizzati non sono ammessi all'interno del monumento, i sentieri appena fuori presentano lo stesso terreno di canyon, petroglifi e formazioni geologiche."}},{"@type":"Question","name":"A che distanza si trova Adventure Tours Vernal da Dinosaur National Monument?","acceptedAnswer":{"@type":"Answer","text":"Adventure Tours Vernal ha sede a Vernal, Utah, a circa 20 minuti a ovest del Quarry Exhibit Hall del monumento. Molti visitatori abbinano un tour in UTV a una visita al monumento nello stesso viaggio."}},{"@type":"Question","name":"Qual è il modo migliore per abbinare un tour in UTV a Dinosaur National Monument?","acceptedAnswer":{"@type":"Answer","text":"Prenoti il Suo tour in UTV per il mattino e visiti il monumento nel pomeriggio, o viceversa. Un tour guidato di 3 ore in UTV più mezza giornata al monumento formano una giornata completa di avventura nella terra dei canyon."}}]}]}`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="Tour UTV Vicino a Dinosaur National Monument | Adventure Tours"
      description="Tour guidati in UTV vicino a Dinosaur National Monument a Vernal, Utah. Canyon del backcountry, petroglifi e deserto a pochi minuti dal monumento. Prenoti oggi."
      path="/it/dinosaur-national-monument/"
      type="article"
      ogTitle="Tour UTV Vicino a Dinosaur National Monument"
      ogDescription="Tour guidati in Kawasaki KRX 1000 nel backcountry che circonda Dinosaur National Monument — canyon, petroglifi e avventura nel deserto."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="dinosaur-national-monument" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: 'Tour al Monumento dei Dinosauri' }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <HubIndex slot="body" collection="dinosaur-national-monument" heading="Tutte le Guide al Monumento dei Dinosauri" />
  <Footer slot="body" variant="compact" />
</BaseLayout>
