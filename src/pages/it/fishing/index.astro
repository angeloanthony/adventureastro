const schema = `{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": "La Guida Definitiva alla Pesca in Terra dei Dinosauri",
        "description": "Il piano di una guida locale per pescare vicino a Vernal, Utah e in tutta la Terra dei Dinosauri — Flaming Gorge, il Green River, i laghi di montagna Uinta, Red Fleet e Steinaker — con consigli su come scegliere l'acqua giusta in base a obiettivo, esperienza e stagione.",
        "author": {"@type": "Organization", "name": "Adventure Tours Vernal"},
        "publisher": {"@type": "Organization", "name": "Adventure Tours Vernal", "logo": {"@type": "ImageObject", "url": "https://adventuretoursvernal.com/images/logo.webp"}},
        "datePublished": "2026-07-11",
        "dateModified": "2026-07-11",
        "mainEntityOfPage": "https://adventuretoursvernal.com/it/fishing/"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {"@type": "Question", "name": "Dov'è la pesca migliore vicino a Vernal, Utah?", "acceptedAnswer": {"@type": "Answer", "text": "Dipende dal Suo obiettivo. Flaming Gorge, a circa un'ora a nord, è l'acqua di punta della regione per la trota di lago da trofeo e la grande trota fario. Il Green River, a valle della diga, è un tailwater di pesca a mosca di fama mondiale. Per una pesca facile, vicina e adatta alle famiglie, i bacini di Red Fleet e Steinaker sono a pochi minuti dalla città, e i laghi di montagna Uinta nella Ashley National Forest offrono una pesca di trota scenografica in alta quota."}},
          {"@type": "Question", "name": "Serve una licenza di pesca per pescare vicino a Vernal?", "acceptedAnswer": {"@type": "Answer", "text": "Sì. Chiunque peschi nello Utah necessita di una licenza di pesca dello Utah valida, disponibile in varie durate. Flaming Gorge si estende in Wyoming e prevede un accordo di licenza reciproca per il bacino, e le regole differiscono da quelle del Green River a valle della diga. Licenze, limiti e regolamenti cambiano, quindi confermi i requisiti attuali con lo Utah Division of Wildlife Resources (e con il Wyoming Game and Fish per Flaming Gorge) prima di pescare."}},
          {"@type": "Question", "name": "Si può pescare tutto l'anno in Terra dei Dinosauri?", "acceptedAnswer": {"@type": "Answer", "text": "Sì, in forme diverse. La pesca in acque libere si estende dalla primavera all'autunno nei bacini e nel Green River, i laghi alti Uinta rendono al meglio in estate dopo lo scioglimento della neve, e l'inverno porta la pesca sul ghiaccio a Flaming Gorge e ai bacini più bassi quando le condizioni lo permettono. Confermi sempre le condizioni attuali del ghiaccio e l'accesso stagionale prima di un viaggio invernale."}},
          {"@type": "Question", "name": "Quali pesci si possono catturare vicino a Vernal?", "acceptedAnswer": {"@type": "Answer", "text": "La regione offre trota di lago (mackinaw), trota fario, trota iridea, salmone kokanee e persico trota a Flaming Gorge; trote iridee e fario selvatiche nel Green River; trota di torrente, trota golarossa, trota tigre e trota iridea, oltre al temolo artico, nei laghi Uinta; e trota iridea insieme a persico trota e bluegill a Red Fleet e Steinaker. Le specie e il ripopolamento cambiano, quindi verifichi i dettagli attuali con lo Utah Division of Wildlife Resources."}},
          {"@type": "Question", "name": "È meglio Flaming Gorge o il Green River per pescare?", "acceptedAnswer": {"@type": "Answer", "text": "Sono esperienze diverse. Flaming Gorge è pesca in grandi acque di bacino, di solito in barca, famosa per la trota di lago da trofeo e la trota fario da trofeo. Il Green River, a valle della diga, è un tailwater freddo e limpido per la pesca a mosca di trota selvatica, pescato con escursioni in drift boat o in guado. Molti pescatori fanno entrambe le cose nello stesso viaggio."}},
          {"@type": "Question", "name": "Dove possono pescare i principianti e le famiglie vicino a Vernal?", "acceptedAnswer": {"@type": "Answer", "text": "I bacini di Red Fleet e Steinaker sono le opzioni più facili e adatte alle famiglie — vicini alla città, caldi in estate, e pescabili da riva senza barca. Sono ideali per introdurre i bambini alla pesca, ed entrambi si abbinano naturalmente al nuoto e alla canoa per una giornata in famiglia completa."}},
          {"@type": "Question", "name": "Si può pescare da riva, o serve una barca?", "acceptedAnswer": {"@type": "Answer", "text": "Entrambe le opzioni funzionano. Red Fleet, Steinaker e parti di Flaming Gorge e del Green River offrono una produttiva pesca da riva e in guado, perfetta per principianti e famiglie. Una barca apre l'accesso alle acque più profonde del bacino — essenziale per insidiare le grandi trote di lago a Flaming Gorge — e le escursioni in drift boat sono il modo classico di pescare nel Green River."}},
          {"@type": "Question", "name": "Come posso pianificare un viaggio di pesca in Terra dei Dinosauri?", "acceptedAnswer": {"@type": "Answer", "text": "Si stabilisca a Vernal, che offre alloggio, carburante e rifornimenti, poi faccia escursioni di un giorno all'acqua che corrisponde al Suo obiettivo — Flaming Gorge e il Green River a nord, Red Fleet e Steinaker a pochi minuti dalla città, e i laghi Uinta in montagna. Acquisti la Sua licenza dello Utah in anticipo, verifichi i regolamenti attuali per ciascuna acqua, e controlli il meteo, poiché le condizioni dell'alto deserto e della montagna cambiano rapidamente."}}
        ]
      }
    ]
  }`;
