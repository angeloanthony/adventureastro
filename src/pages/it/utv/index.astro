---
// it/utv/index.astro — Italian UTV landing page (P6 batch, formal "Lei"
// register). Mirrors src/pages/es/utv/index.astro structurally, which in
// turn mirrors src/pages/utv/index.astro.
//
// Unlike the Spanish P3A page, the Italian UTV spoke articles (all 7)
// already exist as translated MDX by the time this pillar lands (P5A
// batch, see IT_SLUGS in src/lib/i18n.ts) — so HubIndex's `utv` collection
// read will surface Italian titles/links here once locale is 'it', with no
// change needed to HubIndex itself.
import { getBodyHtml } from '../../../page-content/utv';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../config/site';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Seo from '../../../components/seo/Seo.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import HubIndex from '../../../components/content/HubIndex.astro';
import TourDecisionGuide from '../../../components/content/TourDecisionGuide.astro';
import { getLangFromUrl } from '../../../lib/i18n';
import { t } from '../../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
const schema = `
  {
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "name": "Tour sui Sentieri in UTV — Adventure Tours Vernal",
    "description": "Tour guidati in UTV vicino a Vernal, Utah. I sentieri includono Doc's Beach, Moonshine Arch, Ashley Gorge, Outlaw Trail e Asphalt Ridge. Petroglifi, fauna selvatica tra cui aquile reali, aquile calve, cervi e puma, e ampi punti panoramici.",
    "url": "https://adventuretoursvernal.com/it/utv/",
    "image": "https://adventuretoursvernal.com/images/Docs%20Beach.webp",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Adventure Tours Vernal",
      "telephone": "+1-435-219-9447",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1935 S 1500 E",
        "addressLocality": "Vernal",
        "addressRegion": "UT",
        "postalCode": "84078",
        "addressCountry": "US"
      }
    }
  }
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="Tour sui Sentieri in UTV a Vernal, Utah | Adventure Tours Vernal"
      description="Scopra i tour guidati sui sentieri in UTV Kawasaki KRX 1000 vicino a Vernal, Utah — Doc's Beach, Moonshine Arch, Ashley Gorge e altri. Chiami il (435) 219-9447."
      path="/it/utv/"
      type="website"
      image="https://adventuretoursvernal.com/images/Docs%20Beach.webp"
      ogTitle="Tour sui Sentieri in UTV | Adventure Tours Vernal"
      ogDescription="Cinque tour guidati sui sentieri in UTV vicino a Vernal, Utah. Aquile, petroglifi, canyon e paesaggi mozzafiato. Chiami il (435) 219-9447."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="trails" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.trails', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <TourDecisionGuide slot="body" />
  <HubIndex slot="body" collection="utv" heading="Tutte le Guide sui Sentieri in UTV" />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.ourTrails', lang),
      links: [
        { href: '/it/utv/', label: "Doc's Beach" },
        { href: '/it/utv/', label: 'Moonshine Arch' },
        { href: '/it/utv/', label: 'Ashley Gorge' },
        { href: '/it/utv/', label: 'Outlaw Trail' },
        { href: '/it/utv/', label: 'Asphalt Ridge' },
      ],
    }}
    contact={{ heading: 'Contatto' }}
  />
</BaseLayout>
