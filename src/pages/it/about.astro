---
// it/about.astro — Italian about page (P6 formal-register translation batch,
// mirrors Spanish P3A). Person + TouristInformationCenter schema: translated
// jobTitle/description/knowsAbout (visible structured content); business-identity
// fields (name/address/rating) stay byte-identical.
import { getBodyHtml } from '../../page-content/about';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../../lib/i18n';
import { t } from '../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
const schema = `
  [
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Dave Wilson",
      "jobTitle": "Proprietario e Guida Principale",
      "description": "Dave Wilson è il proprietario e la guida principale di Adventure Tours Vernal, la principale azienda di tour in UTV dell'Uintah Basin. Cresciuto esplorando le montagne Wasatch e Oquirrh, Dave ha sviluppato una passione per tutta la vita per l'avventura all'aria aperta. Dopo essersi trasferito a Vernal, Utah, con la moglie Trudy, ha fondato Adventure Tours Vernal per condividere le meraviglie naturali dell'Uintah Basin — dal Dinosaur National Monument a Flaming Gorge — con visitatori e residenti locali.",
      "url": "https://adventuretoursvernal.com/it/about/",
      "image": "https://adventuretoursvernal.com/images/wilson-family.webp",
      "worksFor": {
        "@type": "TouristInformationCenter",
        "name": "Adventure Tours Vernal",
        "url": "https://adventuretoursvernal.com"
      },
      "knowsAbout": [
        "Tour in UTV a Vernal, Utah",
        "Dinosaur National Monument",
        "Flaming Gorge",
        "Sentieri nel backcountry dell'Uintah Basin",
        "Tour in UTV Kawasaki KRX 1000 side-by-side",
        "Avventura all'aria aperta nello Utah"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "TouristInformationCenter",
      "name": "Adventure Tours Vernal",
      "image": "https://adventuretoursvernal.com/images/logo.webp",
      "telephone": "+1-435-219-9447",
      "email": "adventuretoursvernal@gmail.com",
      "url": "https://adventuretoursvernal.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1935 S 1500 E",
        "addressLocality": "Vernal",
        "addressRegion": "UT",
        "postalCode": "84078",
        "addressCountry": "US"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "reviewCount": "82",
        "bestRating": "5",
        "worstRating": "1"
      },
      "founder": {
        "@type": "Person",
        "name": "Dave Wilson"
      }
    }
  ]
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="Chi Siamo | Adventure Tours Vernal — Dave e Trudy Wilson"
      description="Conosca Dave e Trudy Wilson, proprietari di Adventure Tours Vernal. Tour in UTV locale a Vernal, Utah. 5.0 stelle, 82 recensioni. Chiami il (435) 219-9447."
      path="/it/about/"
      type="website"
      image="https://adventuretoursvernal.com/images/wilson-family.webp"
      ogTitle="Chi Siamo di Adventure Tours Vernal | Conosca la Famiglia Wilson"
      ogDescription="Dave e Trudy Wilson condividono la loro passione per l'Uintah Basin con tour guidati in UTV Kawasaki KRX 1000 a Vernal, Utah. 5 stelle. Chiami il (435) 219-9447."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="about" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.about', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.quickLinks', lang),
      links: [
        { href: '/it/#tours', label: t('footer.link.ourTours', lang) },
        { href: '/it/#vehicles', label: t('footer.link.ourFleet', lang) },
        { href: '/it/#gallery', label: t('footer.link.photoGallery', lang) },
        { href: '/it/booking/', label: t('cta.bookNow', lang) },
      ],
    }}
  />
</BaseLayout>
