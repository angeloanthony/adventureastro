---
import { bodyHtml } from '../page-content/cancellation';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Seo from '../components/seo/Seo.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../lib/i18n';
import { t } from '../lib/ui';
const lang = getLangFromUrl(Astro.url);
---
<BaseLayout bodyClass="policy-page-body">
  <Fragment slot="head">
    <Seo
      title="Cancellation Policy | Adventure Tours Vernal — Vernal, Utah"
      description="Cancellation and refund policy for Adventure Tours Vernal guided UTV tours in Vernal, Utah. 72+ hours = full refund. Questions? Call (435) 219-9447."
      path="/cancellation-policy/"
      type="website"
      ogTitle="Cancellation Policy | Adventure Tours Vernal"
      ogDescription="Review the cancellation and refund policy for guided UTV tours in Vernal, Utah. Full refunds available with 72+ hours notice. Call (435) 219-9447."
    />
  </Fragment>
  <Header slot="body" active="cancellation-policy" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.cancellationPolicy', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.quickLinks', lang),
      links: [
        { href: '/utv/', label: t('footer.link.ourTours', lang) },
        { href: '/#vehicles', label: t('footer.link.ourFleet', lang) },
        { href: '/#gallery', label: t('footer.link.photoGallery', lang) },
        { href: '/booking/', label: t('cta.bookNow', lang) },
      ],
    }}
  />
</BaseLayout>
