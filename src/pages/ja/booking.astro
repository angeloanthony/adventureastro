---
// ja/booking.astro — Japanese booking page (mirrors de/booking.astro structurally;
// polite です・ます register per the Japanese inline-pages batch).
// Mirrors src/pages/booking.astro; LocalBusiness schema fields are
// business-identity data (name/address/hours), not page copy, so only
// the page-specific "url" changes to this page's own /ja/ address.
import { getBodyHtml } from '../../page-content/booking';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../../lib/i18n';
import { t } from '../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
const schema = `
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Adventure Tours Vernal",
    "url": "https://adventuretoursvernal.com/ja/booking/",
    "image": "https://adventuretoursvernal.com/images/logo.webp",
    "telephone": "+1-435-219-9447",
    "email": "adventuretoursvernal@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1935 S 1500 E",
      "addressLocality": "Vernal",
      "addressRegion": "UT",
      "postalCode": "84078",
      "addressCountry": "US"
    },
    "openingHours": "Mo-Su 07:00-19:00"
  }
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="UTVツアーのご予約 | Adventure Tours Vernal"
      description="ユタ州バーナルでKawasaki KRX 1000のガイド付きUTVツアーをご予約ください。景色の美しい5つのトレイルからお選びいただけます。リアルタイムカレンダーで空き状況を確認でき、即時予約が可能です。年中無休、毎日7am – 7pm営業。"
      path="/ja/booking/"
      type="website"
      ogDescription="ユタ州バーナルでのガイド付きKawasaki KRX 1000 UTVツアー。リアルタイムカレンダーで即時予約。年中無休、毎日7am – 7pm営業。お電話は (435) 219-9447 まで。"
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: 'ツアーのご予約' }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer slot="body" />
</BaseLayout>
