---
// ja/index.astro — Japanese homepage (P10K inline batch, mirrors de/index.astro).
// Mirrors src/pages/index.astro exactly; only Seo/schema copy and the
// page-content locale differ. lang is URL-derived ('ja'), same as every
// other page — no new routing/lang-prop mechanism introduced.
import { getBodyHtml } from "../../page-content/home";
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import { SITE } from '../../config/site';
import { getLangFromUrl } from '../../lib/i18n';
import { t } from '../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
// TouristInformationCenter + OfferCatalog structured data — translated
// name/description fields; business identity fields (name, url root,
// address, geo, rating) stay byte-identical to the English page (same
// business entity, not page-specific copy).
const schema = `
  {
    "@context": "https://schema.org",
    "@type": "TouristInformationCenter",
    "name": "Adventure Tours Vernal",
    "image": "https://adventuretoursvernal.com/images/logo.webp",
    "telephone": "+1-435-219-9447",
    "email": "adventuretoursvernal@gmail.com",
    "url": "https://adventuretoursvernal.com",
    "priceRange": "$$$",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1935 S 1500 E",
      "addressLocality": "Vernal",
      "addressRegion": "UT",
      "postalCode": "84078",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 40.4555,
      "longitude": -109.5287
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": [
        "Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"
      ],
      "opens": "07:00",
      "closes": "19:00"
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "5.0",
      "reviewCount": "82",
      "bestRating": "5",
      "worstRating": "1"
    },
    "employee": {
      "@type": "Person",
      "name": "Dave Wilson",
      "jobTitle": "チーフガイド兼オーナー",
      "description": "Dave Wilsonは、Uintah Basinを拠点とする地元経営のUTVツアー会社 Adventure Tours Vernal のオーナー兼チーフガイドです。バーナルのバックカントリートレイル、Dinosaur National Monument、そしてユタ州の高地砂漠地形を知り尽くしています。",
      "url": "https://adventuretoursvernal.com/ja/about/"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "ガイド付きUTV・サイドバイサイドツアー — ユタ州バーナル",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Doc's Beach UTVツアー",
            "description": "Doc's Beachへ向かうガイド付きサイドバイサイドの冒険。オフロードトレイル、砂地の砂漠地形、そしてユタ州バーナル近郊に広がるUintah Basinの雄大な眺めをお楽しみいただけます。",
            "provider": { "@type": "LocalBusiness", "name": "Adventure Tours Vernal" },
            "areaServed": "Vernal, Utah"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Moonshine Arch UTVツアー",
            "description": "Moonshine Archへ向かうKawasaki KRX 1000のガイド付きツアー。ユタ州バーナル近郊の赤い岩の峡谷と高地砂漠の台地を縫って進みます。",
            "provider": { "@type": "LocalBusiness", "name": "Adventure Tours Vernal" },
            "areaServed": "Vernal, Utah"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Ashley Gorge UTVツアー",
            "description": "迫力あるAshley Gorgeの峡谷回廊を巡るガイド付きサイドバイサイドツアー。ユタ州バーナル近郊で、そびえ立つ砂岩の壁と川沿いの谷の風景が広がります。",
            "provider": { "@type": "LocalBusiness", "name": "Adventure Tours Vernal" },
            "areaServed": "Vernal, Utah"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Outlaw Trail UTVツアー",
            "description": "ユタ州の歴史的なOutlaw Trailをたどるガイド付きバックカントリーUTVツアー。ユタ州バーナル近郊で、かつてButch CassidyのWild Bunchが使った険しい峡谷地形を走ります。",
            "provider": { "@type": "LocalBusiness", "name": "Adventure Tours Vernal" },
            "areaServed": "Vernal, Utah"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Asphalt Ridge UTVツアー",
            "description": "Asphalt Ridgeの尾根上を走るKawasaki KRX 1000のガイド付きツアー。ユタ州バーナル近郊で、Dinosaur CountryとUintah Mountainsのパノラマを一望できます。",
            "provider": { "@type": "LocalBusiness", "name": "Adventure Tours Vernal" },
            "areaServed": "Vernal, Utah"
          }
        }
      ]
    }
  }
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="ユタ州バーナルのガイド付きUTVツアー | Adventure Tours Vernal"
      description="Adventure Tours Vernalは、ユタ州バーナルでKawasaki KRX 1000サイドバイサイドによるガイド付きUTVツアーを催行しています。Dinosaur Countryのバックカントリーを走る5つ星のツアーです。年中無休、午前7時〜午後7時営業。お電話は(435) 219-9447まで。"
      path="/ja/"
      type="website"
      ogTitle="Adventure Tours Vernal | ユタ州Dinosaur Countryのガイド付きUTVツアー"
      ogDescription="バーナルのバックカントリーを走るKawasaki KRX 1000サイドバイサイドのガイド付きツアー。5.0つ星、82件のレビュー。ご予約は(435) 219-9447までお電話ください。"
      twitterTitle="Adventure Tours Vernal | ユタ州のガイド付きUTVツアー"
      twitterDescription="バーナルのバックカントリーを走るKawasaki KRX 1000サイドバイサイドのガイド付きツアー。5.0つ星、82件のレビュー。"
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="home" />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.ourTrails', lang),
      links: [
        { href: '#tours', label: "Doc's Beach" },
        { href: '#tours', label: 'Moonshine Arch' },
        { href: '#tours', label: 'Ashley Gorge' },
        { href: '#tours', label: 'Outlaw Trail' },
        { href: '#tours', label: 'Asphalt Ridge' },
        { href: '/ja/booking/', label: t('cta.bookNow', lang), class: 'nav-book-btn' },
      ],
    }}
    contact={{ emailAsLink: true }}
    info={{
      heading: t('footer.information', lang),
      links: [
        { href: '/ja/cancellation-policy/', label: t('nav.cancellationPolicy', lang) },
        { href: '/ja/privacy-policy/', label: t('nav.privacyPolicy', lang) },
        { href: '/ja/faq/', label: t('nav.faq', lang) },
        { href: '/ja/safety-guidelines/', label: t('nav.safetyGuidelines', lang) },
        { href: '/ja/guides/what-to-bring/', label: t('nav.whatToBring', lang) },
      ],
      secondHeading: t('section.exploreVernal', lang),
      secondLinks: [
        { href: '/utv/', label: t('footer.link.utvTrailsTours', lang) },
        { href: '/things-to-do/', label: t('footer.link.thingsToDo', lang) },
        { href: '/dinosaur-national-monument/', label: t('footer.link.dinosaurNationalMonument', lang) },
        { href: '/guides/', label: t('footer.link.guides', lang) },
        { href: '/from/salt-lake-city/', label: t('footer.link.visitingFromSLC', lang) },
      ],
    }}
  />
</BaseLayout>
