---
// ja/utv/index.astro — Japanese UTV landing page (P10K batch B, polite
// です・ます register). Mirrors src/pages/de/utv/index.astro structurally,
// which in turn mirrors src/pages/utv/index.astro.
//
// The Japanese UTV spoke articles (all 7) already exist as translated MDX
// by the time this pillar lands (see JA_SLUGS in src/lib/i18n.ts) — so
// HubIndex's `utv` collection read will surface Japanese titles/links here
// once locale is 'ja', with no change needed to HubIndex itself.
import { getBodyHtml } from '../../../page-content/utv';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../config/site';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Seo from '../../../components/seo/Seo.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import HubIndex from '../../../components/content/HubIndex.astro';
import TourDecisionGuide from '../../../components/content/TourDecisionGuide.astro';
import { getLangFromUrl } from '../../../lib/i18n';
import { t } from '../../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
const schema = `
  {
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "name": "UTVトレイルツアー — Adventure Tours Vernal",
    "description": "ユタ州バーナル周辺のガイド付きUTVツアー。トレイルはDoc's Beach、Moonshine Arch、Ashley Gorge、Outlaw Trail、Asphalt Ridgeです。岩絵、イヌワシやハクトウワシ、シカ、ピューマなどの野生動物、そして雄大な展望ポイントをお楽しみいただけます。",
    "url": "https://adventuretoursvernal.com/ja/utv/",
    "image": "https://adventuretoursvernal.com/images/Docs%20Beach.webp",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Adventure Tours Vernal",
      "telephone": "+1-435-219-9447",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1935 S 1500 E",
        "addressLocality": "Vernal",
        "addressRegion": "UT",
        "postalCode": "84078",
        "addressCountry": "US"
      }
    }
  }
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="ユタ州バーナルのUTVトレイルツアー | Adventure Tours Vernal"
      description="ユタ州バーナル周辺をめぐるKawasaki KRX 1000のガイド付きUTVトレイルツアー。Doc's Beach、Moonshine Arch、Ashley Gorge、Outlaw Trail、Asphalt Ridgeの5コース。古代の岩絵や雄大な峡谷の展望が待っています。ご予約は(435) 219-9447まで。"
      path="/ja/utv/"
      type="website"
      image="https://adventuretoursvernal.com/images/Docs%20Beach.webp"
      ogTitle="UTVトレイルツアー | Adventure Tours Vernal"
      ogDescription="ユタ州バーナル周辺のガイド付きUTVトレイルツアーが5コース。イヌワシや古代の岩絵、雄大な峡谷、そして息をのむ絶景が待っています。お電話は(435) 219-9447まで。"
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="trails" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.trails', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <TourDecisionGuide slot="body" />
  <HubIndex slot="body" collection="utv" heading="UTVトレイルガイド一覧" />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.ourTrails', lang),
      // Trail names are place names — kept verbatim, never translated.
      links: [
        { href: '/ja/utv/', label: "Doc's Beach" },
        { href: '/ja/utv/', label: 'Moonshine Arch' },
        { href: '/ja/utv/', label: 'Ashley Gorge' },
        { href: '/ja/utv/', label: 'Outlaw Trail' },
        { href: '/ja/utv/', label: 'Asphalt Ridge' },
      ],
    }}
    contact={{ heading: t('footer.contactInfo', lang) }}
  />
</BaseLayout>
