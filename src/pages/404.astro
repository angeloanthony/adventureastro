---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLangFromUrl } from '../lib/i18n';
import { t } from '../lib/ui';
// 404 ships its own standalone nav (assets={false}, no Header). Its nav
// LABELS are the same chrome as Header — route them through the shared t()
// dictionary so they can never drift from the real nav. 'Information ▾' is
// left as-is: it differs from Header's 'Info ▾' (a pre-existing wording
// difference), and P2C preserves existing output rather than silently
// normalizing it (extraction is lossless — surface, don't fix).
const lang = getLangFromUrl(Astro.url);
const headHtml = `
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Page Not Found | Adventure Tours Vernal</title>
  <meta name="description" content="This page doesn't exist. Find guided UTV tours, trail guides, and booking for Adventure Tours Vernal in Vernal, Utah. Call (435) 219-9447.">
  <meta name="robots" content="noindex">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700;800&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" href="/images/logo2.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="icon" type="image/webp" href="/images/logo1.webp">
`;
const bodyHtml = `
<!-- Navigation -->
<nav class="navbar">
  <div class="nav-container">
    <a href="/" class="logo">
      <img src="/images/logo.webp" alt="Adventure Tours Vernal">
    </a>
    <ul class="nav-menu">
      <li><a href="/">${t('nav.home', lang)}</a></li>
      <li><a href="/about/">${t('nav.about', lang)}</a></li>
      <li><a href="/utv/">${t('nav.trails', lang)}</a></li>
      <li class="nav-dropdown">
        <a href="#" class="dropdown-toggle">Information ▾</a>
        <ul class="dropdown-menu">
          <li><a href="/cancellation-policy/">${t('nav.cancellationPolicy', lang)}</a></li>
          <li><a href="/privacy-policy/">${t('nav.privacyPolicy', lang)}</a></li>
          <li><a href="/faq/">${t('nav.faq', lang)}</a></li>
          <li><a href="/safety-guidelines/">${t('nav.safetyGuidelines', lang)}</a></li>
          <li><a href="/guides/what-to-bring/">${t('nav.whatToBring', lang)}</a></li>
        </ul>
      </li>
      <li><a href="tel:435-219-9447" class="nav-phone">📞 (435) 219-9447</a></li>
      <li><a href="/booking/" class="nav-book-btn">${t('cta.bookNow', lang)}</a></li>
    </ul>
    <button class="mobile-menu-toggle" aria-label="${t('a11y.toggleMenu', lang)}">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<section class="policy-section">
  <div class="container">
    <div class="section-header">
      <h1 class="section-title">Page Not Found</h1>
      <p class="section-subtitle">The trail you're looking for doesn't exist — but the real ones do. Here's where to go next:</p>
    </div>
    <div class="policy-container">
      <div class="policy-card">
        <div class="policy-icon">🧭</div>
        <h2 class="policy-heading">Get Back on the Trail</h2>
        <ul>
          <li><a href="/">Home</a> — start here</li>
          <li><a href="/utv/">Our Trails</a> — Doc's Beach, Moonshine Arch, Ashley Gorge, Outlaw Trail &amp; Asphalt Ridge</li>
          <li><a href="/booking/">Book a Tour</a> — live calendar, instant booking</li>
          <li><a href="/faq/">FAQ</a> — common questions answered</li>
        </ul>
        <p>Or call us directly: <a href="tel:435-219-9447">(435) 219-9447</a> — open daily 7am–7pm.</p>
      </div>
    </div>
  </div>
</section>

`;
---
<BaseLayout assets={false}>
  <Fragment slot="head" set:html={headHtml} />
  <Fragment slot="body" set:html={bodyHtml} />
</BaseLayout>
