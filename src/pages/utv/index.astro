    "image": "https://adventuretoursvernal.com/images/Docs%20Beach.webp",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Adventure Tours Vernal",
      "telephone": "+1-435-219-9447",
      "address": {
        "@type": "PostalAddress",
