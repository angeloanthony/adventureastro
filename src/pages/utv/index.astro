---
import { bodyHtml } from '../../page-content/utv';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import HubIndex from '../../components/content/HubIndex.astro';
import TourDecisionGuide from '../../components/content/TourDecisionGuide.astro';
import { getLangFromUrl } from '../../lib/i18n';
import { t } from '../../lib/ui';
const lang = getLangFromUrl(Astro.url);
// TouristAttraction + provider LocalBusiness preserved verbatim from the legacy head.
const schema = `
  {
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "name": "UTV Trail Tours — Adventure Tours Vernal",
    "description": "Guided UTV tours near Vernal, Utah. Trails include Doc's Beach, Moonshine Arch, Ashley Gorge, Outlaw Trail, and Asphalt Ridge. Petroglyphs, wildlife including golden eagles, bald eagles, deer, and cougar, and sweeping scenic overlooks.",
    "url": "https://adventuretoursvernal.com/utv/",
    "image": "https://adventuretoursvernal.com/images/Docs%20Beach.webp",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Adventure Tours Vernal",
      "telephone": "+1-435-219-9447",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1935 S 1500 E",
        "addressLocality": "Vernal",
        "addressRegion": "UT",
        "postalCode": "84078",
        "addressCountry": "US"
      }
    }
  }
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="UTV Trail Tours in Vernal, Utah | Adventure Tours Vernal"
      description="Explore guided Kawasaki KRX 1000 UTV trail tours near Vernal, Utah — Doc's Beach, Moonshine Arch, Ashley Gorge, Outlaw Trail & Asphalt Ridge. Call (435) 219-9447."
      path="/utv/"
      type="website"
      image="https://adventuretoursvernal.com/images/Docs%20Beach.webp"
      ogTitle="UTV Trail Tours | Adventure Tours Vernal"
      ogDescription="Five guided UTV trail tours near Vernal, Utah. Eagles, petroglyphs, canyons, and breathtaking scenery. Call (435) 219-9447."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="trails" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.trails', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <TourDecisionGuide slot="body" />
  <HubIndex slot="body" collection="utv" heading="All UTV Trail Guides" />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.ourTrails', lang),
      // Trail names are place names — kept verbatim, never translated.
      links: [
        { href: '/utv/', label: "Doc's Beach" },
        { href: '/utv/', label: 'Moonshine Arch' },
        { href: '/utv/', label: 'Ashley Gorge' },
        { href: '/utv/', label: 'Outlaw Trail' },
        { href: '/utv/', label: 'Asphalt Ridge' },
      ],
    }}
    contact={{ heading: 'Contact' }}
  />
</BaseLayout>
