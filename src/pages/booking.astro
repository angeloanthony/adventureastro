---
import { bodyHtml } from '../page-content/booking';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Seo from '../components/seo/Seo.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { SITE } from '../config/site';
// LocalBusiness structured data preserved verbatim from the legacy head.
const schema = `
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Adventure Tours Vernal",
    "url": "https://adventuretoursvernal.com/booking/",
    "image": "https://adventuretoursvernal.com/images/logo.webp",
    "telephone": "+1-435-219-9447",
    "email": "adventuretoursvernal@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1935 S 1500 E",
      "addressLocality": "Vernal",
      "addressRegion": "UT",
      "postalCode": "84078",
      "addressCountry": "US"
    },
    "openingHours": "Mo-Su 07:00-19:00"
  }
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="Book Your UTV Tour | Adventure Tours Vernal"
      description="Book a guided Kawasaki KRX 1000 UTV tour in Vernal, Utah. Choose from Doc's Beach, Moonshine Arch, Ashley Gorge, Outlaw Trail, or Asphalt Ridge. Open daily 7am–7pm."
      path="/booking/"
      type="website"
      ogDescription="Book a guided Kawasaki KRX 1000 UTV tour in Vernal, Utah. Live calendar with instant booking. Open daily 7am–7pm. Call (435) 219-9447."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: 'Book Your Tour' }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer slot="body" />
</BaseLayout>
