---
// fr/booking.astro — French booking page (P8-P6 inline batch, mirrors it/booking.astro).
// Mirrors src/pages/booking.astro; LocalBusiness schema fields are
// business-identity data (name/address/hours), not page copy, so only
// the page-specific "url" changes to this page's own /fr/ address.
import { getBodyHtml } from '../../page-content/booking';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../../lib/i18n';
import { t } from '../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
const schema = `
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "Adventure Tours Vernal",
    "url": "https://adventuretoursvernal.com/fr/booking/",
    "image": "https://adventuretoursvernal.com/images/logo.webp",
    "telephone": "+1-435-219-9447",
    "email": "adventuretoursvernal@gmail.com",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1935 S 1500 E",
      "addressLocality": "Vernal",
      "addressRegion": "UT",
      "postalCode": "84078",
      "addressCountry": "US"
    },
    "openingHours": "Mo-Su 07:00-19:00"
  }
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="Réservez Votre Tour en UTV | Adventure Tours Vernal"
      description="Réservez un tour guidé en UTV Kawasaki KRX 1000 à Vernal, Utah. Choisissez parmi cinq pistes panoramiques. Ouvert tous les jours de 7h à 19h."
      path="/fr/booking/"
      type="website"
      ogDescription="Tour guidé en UTV Kawasaki KRX 1000 à Vernal, Utah. Calendrier en temps réel, réservation instantanée. Ouvert tous les jours, 7h–19h. Appelez le (435) 219-9447."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: 'Réservez Votre Tour' }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer slot="body" />
</BaseLayout>
