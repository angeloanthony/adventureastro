---
// fr/privacy-policy.astro — French privacy policy (P8-P6 inline batch).
// Mirrors src/pages/it/privacy-policy.astro.
import { getBodyHtml } from '../../page-content/privacy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../../lib/i18n';
import { t } from '../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
---
<BaseLayout bodyClass="policy-page-body">
  <Fragment slot="head">
    <Seo
      title="Politique de Confidentialité | Adventure Tours Vernal"
      description="Politique de confidentialité d'Adventure Tours Vernal à Vernal, Utah : comment nous collectons, utilisons et protégeons vos informations. Appelez le (435) 219-9447."
      path="/fr/privacy-policy/"
      type="website"
      ogDescription="Comment Adventure Tours Vernal collecte, utilise et protège vos informations lorsque vous réservez un tour guidé en UTV à Vernal, Utah."
    />
  </Fragment>
  <Header slot="body" active="privacy-policy" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.privacyPolicy', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.quickLinks', lang),
      links: [
        { href: '/fr/#tours', label: t('footer.link.ourTours', lang) },
        { href: '/fr/#vehicles', label: t('footer.link.ourFleet', lang) },
        { href: '/fr/#gallery', label: t('footer.link.photoGallery', lang) },
        { href: '/fr/booking/', label: t('cta.bookNow', lang) },
      ],
    }}
    contact={{ showStreet: false }}
    info={{
      heading: t('footer.information', lang),
      links: [
        { href: '/fr/cancellation-policy/', label: t('nav.cancellationPolicy', lang) },
        { href: '/fr/privacy-policy/', label: t('nav.privacyPolicy', lang) },
        { href: '/fr/faq/', label: t('nav.faq', lang) },
        { href: '/fr/safety-guidelines/', label: t('nav.safetyGuidelines', lang) },
      ],
    }}
  />
</BaseLayout>
