---
// fr/about.astro — French about page (P8 formal-register translation batch,
// mirrors Italian P6 / Spanish P3A). Person + TouristInformationCenter schema:
// translated jobTitle/description/knowsAbout (visible structured content);
// business-identity fields (name/address/rating) stay byte-identical.
import { getBodyHtml } from '../../page-content/about';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../../lib/i18n';
import { t } from '../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
const schema = `
  [
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Dave Wilson",
      "jobTitle": "Propriétaire et Guide Principal",
      "description": "Dave Wilson est le propriétaire et guide principal d'Adventure Tours Vernal, la première entreprise de tours en UTV de l'Uintah Basin. Ayant grandi en explorant les montagnes Wasatch et Oquirrh, Dave a développé une passion pour toute la vie pour l'aventure en plein air. Après avoir déménagé à Vernal, Utah, avec son épouse Trudy, il a fondé Adventure Tours Vernal pour partager les merveilles naturelles de l'Uintah Basin — du Dinosaur National Monument à Flaming Gorge — avec les visiteurs et les résidents locaux.",
      "url": "https://adventuretoursvernal.com/fr/about/",
      "image": "https://adventuretoursvernal.com/images/wilson-family.webp",
      "worksFor": {
        "@type": "TouristInformationCenter",
        "name": "Adventure Tours Vernal",
        "url": "https://adventuretoursvernal.com"
      },
      "knowsAbout": [
        "Tours en UTV à Vernal, Utah",
        "Dinosaur National Monument",
        "Flaming Gorge",
        "Pistes de backcountry de l'Uintah Basin",
        "Tours en UTV Kawasaki KRX 1000 side-by-side",
        "Aventure en plein air dans l'Utah"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "TouristInformationCenter",
      "name": "Adventure Tours Vernal",
      "image": "https://adventuretoursvernal.com/images/logo.webp",
      "telephone": "+1-435-219-9447",
      "email": "adventuretoursvernal@gmail.com",
      "url": "https://adventuretoursvernal.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1935 S 1500 E",
        "addressLocality": "Vernal",
        "addressRegion": "UT",
        "postalCode": "84078",
        "addressCountry": "US"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "reviewCount": "82",
        "bestRating": "5",
        "worstRating": "1"
      },
      "founder": {
        "@type": "Person",
        "name": "Dave Wilson"
      }
    }
  ]
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="À Propos | Adventure Tours Vernal — Dave et Trudy Wilson"
      description="Découvrez Dave et Trudy Wilson, propriétaires d'Adventure Tours Vernal. Tours en UTV locaux à Vernal, Utah. 5.0 étoiles, 82 avis. Appelez le (435) 219-9447."
      path="/fr/about/"
      type="website"
      image="https://adventuretoursvernal.com/images/wilson-family.webp"
      ogTitle="À Propos d'Adventure Tours Vernal | Découvrez la Famille Wilson"
      ogDescription="Dave et Trudy Wilson partagent leur passion pour l'Uintah Basin avec des tours guidés en UTV Kawasaki KRX 1000 à Vernal, Utah. 5 étoiles. Appelez le (435) 219-9447."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="about" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.about', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.quickLinks', lang),
      links: [
        { href: '/fr/utv/', label: t('footer.link.ourTours', lang) },
        { href: '/fr/#vehicles', label: t('footer.link.ourFleet', lang) },
        { href: '/fr/#gallery', label: t('footer.link.photoGallery', lang) },
        { href: '/fr/booking/', label: t('cta.bookNow', lang) },
      ],
    }}
  />
</BaseLayout>
