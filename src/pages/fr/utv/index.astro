---
// fr/utv/index.astro — French UTV landing page (P8-P6 batch, formal "vous"
// register). Mirrors src/pages/it/utv/index.astro structurally, which in
// turn mirrors src/pages/utv/index.astro.
//
// The French UTV spoke articles (all 7) already exist as translated MDX by
// the time this pillar lands — so HubIndex's `utv` collection read will
// surface French titles/links here once locale is 'fr', with no change
// needed to HubIndex itself.
import { getBodyHtml } from '../../../page-content/utv';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../config/site';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Seo from '../../../components/seo/Seo.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import HubIndex from '../../../components/content/HubIndex.astro';
import TourDecisionGuide from '../../../components/content/TourDecisionGuide.astro';
import { getLangFromUrl } from '../../../lib/i18n';
import { t } from '../../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
const schema = `
  {
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "name": "Tours sur les Sentiers en UTV — Adventure Tours Vernal",
    "description": "Tours guidés en UTV près de Vernal, Utah. Les sentiers incluent Doc's Beach, Moonshine Arch, Ashley Gorge, Outlaw Trail et Asphalt Ridge. Pétroglyphes, faune dont aigles royaux, pygargues à tête blanche, cerfs et pumas, et vastes points de vue panoramiques.",
    "url": "https://adventuretoursvernal.com/fr/utv/",
    "image": "https://adventuretoursvernal.com/images/Docs%20Beach.webp",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Adventure Tours Vernal",
      "telephone": "+1-435-219-9447",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1935 S 1500 E",
        "addressLocality": "Vernal",
        "addressRegion": "UT",
        "postalCode": "84078",
        "addressCountry": "US"
      }
    }
  }
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="Tours de Sentiers en UTV à Vernal, Utah | Adventure Tours Vernal"
      description="Découvrez les tours guidés en UTV Kawasaki KRX 1000 près de Vernal, Utah — Doc's Beach, Moonshine Arch, Ashley Gorge et plus. Appelez le (435) 219-9447."
      path="/fr/utv/"
      type="website"
      image="https://adventuretoursvernal.com/images/Docs%20Beach.webp"
      ogTitle="Tours sur les Sentiers en UTV | Adventure Tours Vernal"
      ogDescription="Cinq tours guidés sur les sentiers en UTV près de Vernal, Utah. Aigles, pétroglyphes, canyons et paysages à couper le souffle. Appelez le (435) 219-9447."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="trails" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.trails', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <TourDecisionGuide slot="body" />
  <HubIndex slot="body" collection="utv" heading="Tous les Guides sur les Sentiers en UTV" />
  <Footer
    slot="body"
    trails={{
      heading: 'Nos Sentiers',
      links: [
        { href: '/fr/utv/', label: "Doc's Beach" },
        { href: '/fr/utv/', label: 'Moonshine Arch' },
        { href: '/fr/utv/', label: 'Ashley Gorge' },
        { href: '/fr/utv/', label: 'Outlaw Trail' },
        { href: '/fr/utv/', label: 'Asphalt Ridge' },
      ],
    }}
    contact={{ heading: 'Contact' }}
  />
</BaseLayout>
