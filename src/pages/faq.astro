---
import { bodyHtml } from '../page-content/faq';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Seo from '../components/seo/Seo.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../lib/i18n';
import { t } from '../lib/ui';
const lang = getLangFromUrl(Astro.url);
// FAQPage structured data (15 questions) preserved verbatim from the legacy head.
const schema = `
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "Can I bring my own ATV machine on tours?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes! Bringing your own machine allows more catered and even extreme rides. Adventure Tours Vernal provides walkie talkies and offers easier alternatives on hardcore trail sections. Please call or email to explain the type of riding you want to do. Safety is priority number 1, followed closely by enjoyment."
        }
      },
      {
        "@type": "Question",
        "name": "Can I bring a group for ATV tours in Vernal?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Absolutely! Adventure Tours Vernal welcomes group tours of all sizes. Contact us to discuss your group needs including additional sights, restaurants, hotel accommodations, bars, nightlife, and kid-friendly activities in the Uintah Basin. Call (435) 219-9447."
        }
      },
      {
        "@type": "Question",
        "name": "What about weather on ATV tours?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Adventure Tours Vernal operates sunshine or rain. However, in cases of extreme weather or unforeseen circumstances, you will have the option to reschedule or receive a full refund."
        }
      },
      {
        "@type": "Question",
        "name": "What should I bring on an ATV tour in Vernal?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Bring sunglasses, a hat, a camera, a jacket, and closed-toe shoes. Dress in layers as temperature can fluctuate. Adventure Tours Vernal provides complimentary water and a small snack, plus helmets and safety equipment. Sunscreen, bug spray, and chapstick are recommended."
        }
      },
      {
        "@type": "Question",
        "name": "When should I arrive for my ATV tour?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Arrive 30 minutes prior to your departure time for all tours. We will not depart until all safety training is complete. If you are not there when orientation begins, you may lose your spot on the tour, which is non-refundable."
        }
      },
      {
        "@type": "Question",
        "name": "How old do I have to be for ATV tours?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "To drive Adventure Tours Vernal's machines, you need to be at least 18 years of age. To ride as a passenger, you need to be at least 2 years of age."
        }
      },
      {
        "@type": "Question",
        "name": "What is the cancellation policy for ATV tours?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Adventure Tours Vernal has a detailed cancellation policy. Visit the cancellation policy page on adventuretoursvernal.com or call (435) 219-9447 for full details on cancellations and deposits."
        }
      },
      {
        "@type": "Question",
        "name": "How much do ATV tours cost in Vernal Utah?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Adventure Tours Vernal offers one guided 3-hour tour on Kawasaki KRX 1000 side-by-sides: $349 per machine, which seats up to 2 riders. You can add a third rider as a ride-along passenger for $125, or extend your tour for $99 per hour per machine. A 3-person minimum applies, and groups of up to 12 guests (6 machines) are welcome. Call (435) 219-9447 for availability."
        }
      },
      {
        "@type": "Question",
        "name": "Do I need experience to ride an ATV in Vernal?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "No ATV experience is required for tours in Vernal. Adventure Tours Vernal welcomes complete beginners and provides full safety training before every tour. Experienced guides walk you through operating the Kawasaki KRX 1000 side-by-sides step-by-step. All skill levels are welcome."
        }
      },
      {
        "@type": "Question",
        "name": "Can you visit Dinosaur National Monument on an ATV tour?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. Adventure Tours Vernal's guided 3-hour UTV tour explores backcountry trails near Dinosaur National Monument, including ancient rock formations and petroglyphs. The monument's famous wall of dinosaur bones is a separate National Park Service site — many guests pair a morning at the monument with an afternoon UTV tour through the surrounding Dinosaur Country backcountry."
        }
      },
      {
        "@type": "Question",
        "name": "What is the best ATV tour company in Vernal Utah?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Adventure Tours Vernal is the only guided Kawasaki KRX 1000 tour company in Vernal, Utah. We offer exclusive access to hidden trails, petroglyphs, Butch Cassidy hideouts, and scenic arches. Expert local guides, professional safety equipment, and all skill levels welcome. Open daily 7am-7pm. Call (435) 219-9447."
        }
      },
      {
        "@type": "Question",
        "name": "How long are ATV tours in Vernal?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Adventure Tours Vernal offers one standard guided tour that runs about 3 hours. Prefer more time on the trail? You can extend your tour for $99 per hour per machine. Call (435) 219-9447 to arrange a longer ride."
        }
      },
      {
        "@type": "Question",
        "name": "Are ATV tours in Vernal family friendly?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Yes. The guided tour is family-friendly, with a full safety briefing before every ride and passengers welcome from age 2. Each Kawasaki KRX 1000 seats up to 2 riders, so families book multiple machines to ride together — up to 6 machines and 12 guests per tour. No experience needed - full safety training provided."
        }
      },
      {
        "@type": "Question",
        "name": "What are the hours for Adventure Tours Vernal?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Adventure Tours Vernal is open daily from 7:00 AM to 7:00 PM Mountain Time, 7 days a week. Call (435) 219-9447 to book your ATV tour or visit adventuretoursvernal.com."
        }
      },
      {
        "@type": "Question",
        "name": "What tours does Adventure Tours Vernal offer?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "Adventure Tours Vernal offers one guided 3-hour tour on Kawasaki KRX 1000 side-by-sides in Vernal, Utah, with a choice of five trail systems — Doc's Beach, Moonshine Arch, Ashley Gorge, Outlaw Trail, and Asphalt Ridge — selected when you book. Every tour includes expert local guides, a full safety briefing, and safety gear."
        }
      }
    ]
  }
`;
---
<BaseLayout bodyClass="faq-page-body">
  <Fragment slot="head">
    <Seo
      title="FAQ | UTV Tours in Vernal Utah | Adventure Tours Vernal"
      description="Answers to common questions about guided UTV tours in Vernal, Utah. Age requirements, pricing, what to bring, weather policy, and more. Call (435) 219-9447."
      path="/faq/"
      type="website"
      ogTitle="FAQ — Adventure Tours Vernal | Guided UTV Tours in Utah"
      ogDescription="Everything you need to know before your guided Kawasaki KRX 1000 UTV tour in Vernal, Utah. Age limits, pricing, what to bring, and more."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="faq" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.faq', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.quickLinks', lang),
      links: [
        { href: '/#tours', label: t('footer.link.ourTours', lang) },
        { href: '/#vehicles', label: t('footer.link.ourFleet', lang) },
        { href: '/#gallery', label: t('footer.link.photoGallery', lang) },
        { href: '/booking/', label: t('cta.bookNow', lang) },
      ],
    }}
  />
</BaseLayout>
