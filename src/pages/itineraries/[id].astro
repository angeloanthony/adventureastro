---
// itineraries/[id].astro — the ENGLISH itinerary route (Planning Authority
// cluster; P4A locale split). Renders every non-draft *English* `itineraries`
// entry at /itineraries/id/ via ItineraryArticle. Translated entries are
// emitted by src/pages/[locale]/itineraries/[id].astro. Itineraries live on a
// dedicated route (not the generic [hub]/[id]) because 'itineraries' is
// deliberately not a HUB_SLUG — see src/lib/hubs.ts. Draft entries are
// excluded here AND in sitemap-itineraries.xml.ts.
import { getCollection } from 'astro:content';
import ItineraryArticle from '../../components/routing/ItineraryArticle.astro';
import { parseEntryLocale, DEFAULT_LOCALE } from '../../lib/i18n';
import type { SpokeData } from '../../content.config';

type ItineraryEntry = { id: string; data: SpokeData; [key: string]: unknown };

export async function getStaticPaths() {
  const entries = (await getCollection('itineraries')) as unknown as ItineraryEntry[];
  return entries
    .filter((e) => !e.data.draft && parseEntryLocale(e.id).locale === DEFAULT_LOCALE)
    .map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: ItineraryEntry }
const { entry } = Astro.props;
---
<ItineraryArticle entry={entry} />
