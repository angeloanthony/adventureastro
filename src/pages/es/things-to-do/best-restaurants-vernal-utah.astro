    .rest-tips-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:22px;margin:40px 0 60px}
    .rest-tip-card{background:white;border-radius:18px;padding:28px 24px;box-shadow:0 8px 25px rgba(0,0,0,0.06);border:1.5px solid rgba(212,118,78,0.1);transition:all 0.3s ease}
    .rest-tip-card:hover{transform:translateY(-5px);box-shadow:0 14px 35px rgba(212,118,78,0.12);border-color:rgba(212,118,78,0.25)}
    .rest-tip-icon{font-size:2.2rem;margin-bottom:14px}
    .rest-tip-card h3{font-family:var(--font-heading);font-size:1.1rem;font-weight:700;color:var(--charcoal);margin-bottom:8px}
    .rest-tip-card p{font-size:0.92rem;color:var(--charcoal);opacity:0.78;line-height:1.65;margin:0}
    @media(max-width:768px){
      .restaurant-page{margin-top:130px}
      .dining-hero{min-height:280px;border-radius:20px}
      .dining-hero-content{padding:35px 25px 30px}
      .dining-hero-content h1{font-size:1.9rem}
      .discount-banner{flex-direction:column;text-align:center;padding:28px 24px;gap:16px}
      .category-filters{top:60px;gap:8px;padding:10px 0}
      .filter-btn{font-size:0.78rem;padding:8px 16px}
      .restaurant-grid{grid-template-columns:1fr;gap:22px}
      .rest-tips-grid{grid-template-columns:1fr}
      .coupon-modal{padding:35px 25px}
      .card-image{height:200px;background-size:contain;background-repeat:no-repeat}
    }
    @media(max-width:480px){
      .restaurant-page{margin-top:110px}
      .dining-hero{min-height:220px}
      .dining-hero-content h1{font-size:1.65rem;letter-spacing:-0.5px}
      .card-actions{flex-direction:column}
      .card-action-btn{justify-content:center}
      .card-image{height:180px;background-size:contain;background-repeat:no-repeat}
    }
  </style>`;
