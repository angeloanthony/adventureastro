    .action-call{background:linear-gradient(135deg,rgba(212,118,78,0.1),rgba(184,92,62,0.1));color:var(--burnt-orange);border:1.5px solid rgba(212,118,78,0.2)}
    .action-call:hover{background:var(--burnt-orange);color:white;border-color:var(--burnt-orange);transform:translateY(-2px)}
    .action-website{background:linear-gradient(135deg,rgba(168,205,236,0.15),rgba(168,205,236,0.08));color:#2980B9;border:1.5px solid rgba(41,128,185,0.2)}
    .action-website:hover{background:#2980B9;color:white;border-color:#2980B9;transform:translateY(-2px)}
    .action-map{background:linear-gradient(135deg,rgba(184,197,168,0.2),rgba(184,197,168,0.1));color:#27AE60;border:1.5px solid rgba(39,174,96,0.2)}
    .action-map:hover{background:#27AE60;color:white;border-color:#27AE60;transform:translateY(-2px)}
    .coupon-section{background:linear-gradient(135deg,rgba(245,237,227,0.6),rgba(248,244,240,0.8));border-radius:14px;padding:16px 18px;border:1.5px dashed rgba(212,118,78,0.3);position:relative}
    .coupon-label{font-family:var(--font-heading);font-size:0.7rem;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--burnt-orange);margin-bottom:8px;display:flex;align-items:center;gap:6px}
    .coupon-row{display:flex;align-items:center;gap:10px}
    .coupon-code{flex:1;background:white;border:2px solid rgba(212,118,78,0.25);border-radius:10px;padding:10px 14px;font-family:'Courier New',monospace;font-size:1.1rem;font-weight:700;color:var(--burnt-orange);letter-spacing:2px;text-align:center}
    .coupon-copy-btn{background:linear-gradient(135deg,var(--burnt-orange),var(--rust-red));color:white;border:none;border-radius:10px;padding:10px 16px;font-family:var(--font-heading);font-size:0.78rem;font-weight:700;cursor:pointer;transition:all 0.3s ease;white-space:nowrap}
    .coupon-copy-btn:hover{transform:translateY(-2px);box-shadow:0 6px 18px rgba(212,118,78,0.35)}
    .coupon-copy-btn.copied{background:linear-gradient(135deg,#27AE60,#229954)}
    .coupon-show-btn{width:100%;margin-top:10px;padding:12px;border-radius:12px;font-size:0.88rem}
    .coupon-note{font-size:0.76rem;color:var(--charcoal);opacity:0.55;margin-top:8px;line-height:1.4}
    .coupon-modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,0.65);z-index:10000;display:none;align-items:center;justify-content:center;padding:20px;backdrop-filter:blur(5px)}
    .coupon-modal-overlay.visible{display:flex;animation:fadeInModal 0.3s ease}
    .coupon-modal{background:white;border-radius:28px;width:100%;max-width:400px;padding:45px 35px;text-align:center;position:relative;box-shadow:0 30px 80px rgba(0,0,0,0.35)}
    .coupon-modal-close{position:absolute;top:14px;right:16px;background:rgba(0,0,0,0.06);border:none;width:36px;height:36px;border-radius:50%;font-size:1.4rem;cursor:pointer;transition:all 0.3s ease;display:flex;align-items:center;justify-content:center;color:var(--charcoal)}
    .coupon-modal-close:hover{background:rgba(0,0,0,0.1);transform:rotate(90deg)}
    .coupon-modal-icon{font-size:4rem;margin-bottom:12px}
    .coupon-modal h2{font-family:var(--font-heading);font-size:1.5rem;font-weight:800;color:var(--charcoal);margin-bottom:6px}
    .modal-restaurant{font-size:1rem;color:var(--burnt-orange);font-weight:700;margin-bottom:20px}
    .modal-code-box{background:linear-gradient(135deg,rgba(245,237,227,0.8),rgba(248,244,240,1));border:3px dashed var(--burnt-orange);border-radius:16px;padding:22px 20px;margin-bottom:20px}
    .modal-code{font-family:'Courier New',monospace;font-size:2rem;font-weight:800;color:var(--burnt-orange);letter-spacing:4px}
    .modal-discount{font-family:var(--font-heading);font-size:1.3rem;font-weight:800;color:#27AE60;margin-top:10px}
