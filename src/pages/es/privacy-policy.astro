---
// es/privacy-policy.astro — Spanish privacy policy (P3A commercial
// translation batch). Mirrors src/pages/privacy-policy.astro.
import { getBodyHtml } from '../../page-content/privacy';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../../lib/i18n';
import { t } from '../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
---
<BaseLayout bodyClass="policy-page-body">
  <Fragment slot="head">
    <Seo
      title="Política de Privacidad | Adventure Tours Vernal"
      description="Política de privacidad de Adventure Tours Vernal en Vernal, Utah. Cómo recopilamos, usamos y protegemos su información al reservar un tour guiado en UTV. Llame al (435) 219-9447."
      path="/es/privacy-policy/"
      type="website"
      ogDescription="Cómo Adventure Tours Vernal recopila, usa y protege su información al reservar un tour guiado en UTV en Vernal, Utah."
    />
  </Fragment>
  <Header slot="body" active="privacy-policy" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.privacyPolicy', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.quickLinks', lang),
      links: [
        { href: '/es/#tours', label: t('footer.link.ourTours', lang) },
        { href: '/es/#vehicles', label: t('footer.link.ourFleet', lang) },
        { href: '/es/#gallery', label: t('footer.link.photoGallery', lang) },
        { href: '/es/booking/', label: t('cta.bookNow', lang) },
      ],
    }}
    contact={{ showStreet: false }}
    info={{
      heading: t('footer.information', lang),
      links: [
        { href: '/es/cancellation-policy/', label: t('nav.cancellationPolicy', lang) },
        { href: '/es/privacy-policy/', label: t('nav.privacyPolicy', lang) },
        { href: '/es/faq/', label: t('nav.faq', lang) },
        { href: '/es/safety-guidelines/', label: t('nav.safetyGuidelines', lang) },
      ],
    }}
  />
</BaseLayout>
