---
import { bodyHtml } from '../page-content/about';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Seo from '../components/seo/Seo.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../lib/i18n';
import { t } from '../lib/ui';
const lang = getLangFromUrl(Astro.url);
// Person (Dave Wilson) + TouristInformationCenter — the primary E-E-A-T
// signal for this page — preserved verbatim from the legacy head.
const schema = `
  [
    {
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Dave Wilson",
      "jobTitle": "Owner & Lead Guide",
      "description": "Dave Wilson is the owner and lead guide of Adventure Tours Vernal, the premier UTV tour company in the Uintah Basin. Growing up exploring the Wasatch and Oquirrh Mountains, Dave developed a lifelong passion for outdoor adventure. After relocating to Vernal, Utah with his wife Trudy, he founded Adventure Tours Vernal to share the natural wonders of the Uintah Basin — from Dinosaur National Monument to Flaming Gorge — with visitors and locals alike.",
      "url": "https://adventuretoursvernal.com/about/",
      "image": "https://adventuretoursvernal.com/images/wilson-family.webp",
      "worksFor": {
        "@type": "TouristInformationCenter",
        "name": "Adventure Tours Vernal",
        "url": "https://adventuretoursvernal.com"
      },
      "knowsAbout": [
        "UTV tours in Vernal Utah",
        "Dinosaur National Monument",
        "Flaming Gorge",
        "Uintah Basin backcountry trails",
        "Kawasaki KRX 1000 side-by-side tours",
        "Utah outdoor adventure"
      ]
    },
    {
      "@context": "https://schema.org",
      "@type": "TouristInformationCenter",
      "name": "Adventure Tours Vernal",
      "image": "https://adventuretoursvernal.com/images/logo.webp",
      "telephone": "+1-435-219-9447",
      "email": "adventuretoursvernal@gmail.com",
      "url": "https://adventuretoursvernal.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1935 S 1500 E",
        "addressLocality": "Vernal",
        "addressRegion": "UT",
        "postalCode": "84078",
        "addressCountry": "US"
      },
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "5.0",
        "reviewCount": "82",
        "bestRating": "5",
        "worstRating": "1"
      },
      "founder": {
        "@type": "Person",
        "name": "Dave Wilson"
      }
    }
  ]
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="About Us | Adventure Tours Vernal — Dave & Trudy Wilson"
      description="Meet Dave and Trudy Wilson, owners of Adventure Tours Vernal. Locally owned UTV tour company in Vernal, Utah. 5.0 stars, 82 reviews. Call (435) 219-9447."
      path="/about/"
      type="website"
      image="https://adventuretoursvernal.com/images/wilson-family.webp"
      ogTitle="About Adventure Tours Vernal | Meet the Wilson Family"
      ogDescription="Dave and Trudy Wilson share their passion for the Uintah Basin through guided Kawasaki KRX 1000 UTV tours in Vernal, Utah. 5-star rated. Call (435) 219-9447."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="about" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.about', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.quickLinks', lang),
      links: [
        { href: '/#tours', label: t('footer.link.ourTours', lang) },
        { href: '/#vehicles', label: t('footer.link.ourFleet', lang) },
        { href: '/#gallery', label: t('footer.link.photoGallery', lang) },
        { href: '/booking/', label: t('cta.bookNow', lang) },
      ],
    }}
  />
</BaseLayout>
