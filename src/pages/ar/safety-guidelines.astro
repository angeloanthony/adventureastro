---
// ar/safety-guidelines.astro — Arabic safety guidelines (AR-2 Phase F batch 2).
// Mirrors src/pages/safety-guidelines.astro.
//
// §4 link resolution: `/utv/` is not translated yet, and `/#vehicles` / `/#gallery` are
// fragments on the ENGLISH homepage, which is also not translated — all three keep their
// English paths so the fragments still resolve (gate 4s). `/ar/booking/` is registered by
// this batch and switches.
import { getBodyHtml } from '../../page-content/safety';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../../lib/i18n';
import { t } from '../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
---
<BaseLayout bodyClass="policy-page-body">
  <Fragment slot="head">
    <Seo
      title="إرشادات السلامة | Adventure Tours Vernal — Vernal، يوتا"
      description="إرشادات السلامة لجولات UTV المُرشَدة في Vernal بولاية يوتا. متطلبات العمر وقواعد تشغيل المركبة وسلامة المسارات وإجراءات الطوارئ. اتصل على (435) 219-9447."
      path="/ar/safety-guidelines/"
      type="website"
      ogTitle="إرشادات السلامة | Adventure Tours Vernal"
      ogDescription="راجع إرشادات السلامة لجولات UTV المُرشَدة بمركبات Kawasaki KRX 1000 في Vernal بولاية يوتا. حدود العمر وقواعد المركبة وسلامة المسارات وما تتوقّعه. اتصل على (435) 219-9447."
    />
  </Fragment>
  <Header slot="body" active="safety-guidelines" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.safetyGuidelines', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.quickLinks', lang),
      links: [
        { href: '/utv/', label: t('footer.link.ourTours', lang) },
        { href: '/ar/#vehicles', label: t('footer.link.ourFleet', lang) },
        { href: '/ar/#gallery', label: t('footer.link.photoGallery', lang) },
        { href: '/ar/booking/', label: t('cta.bookNow', lang) },
      ],
    }}
  />
</BaseLayout>
