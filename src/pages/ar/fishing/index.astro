const lang = getLangFromUrl(Astro.url);

const schema = `{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": "الدليل الشامل لصيد الأسماك في أرض الديناصورات",
        "description": "خطة دليل محلّي لصيد الأسماك قرب Vernal بولاية يوتا وعبر أرض الديناصورات — Flaming Gorge، وGreen River، وبحيرات Uinta الجبلية، وRed Fleet، وSteinaker — مع إرشادات لاختيار المياه المناسبة بحسب هدفك وخبرتك والموسم.",
        "author": {"@type": "Organization", "name": "Adventure Tours Vernal"},
        "publisher": {"@type": "Organization", "name": "Adventure Tours Vernal", "logo": {"@type": "ImageObject", "url": "https://adventuretoursvernal.com/images/logo.webp"}},
        "datePublished": "2026-07-11",
        "dateModified": "2026-07-11",
        "mainEntityOfPage": "https://adventuretoursvernal.com/ar/fishing/"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {"@type": "Question", "name": "أين أفضل أماكن صيد الأسماك قرب Vernal بولاية يوتا؟", "acceptedAnswer": {"@type": "Answer", "text": "يتوقّف ذلك على هدفك. فـFlaming Gorge، على نحو ساعة شمالًا، هي مياه الإقليم الأبرز لتراوت البحيرات الضخم والتراوت البنّي الكبير. وGreen River أسفل السدّ مياه جارية عالمية المستوى للصيد بالذبابة. وللصيد السهل القريب المناسب للعائلات، تبعد بحيرتا Red Fleet وSteinaker دقائق عن البلدة، وتقدّم بحيرات Uinta الجبلية في Ashley National Forest صيد تراوت خلابًا في المرتفعات."}},
          {"@type": "Question", "name": "هل أحتاج رخصة صيد للصيد قرب Vernal؟", "acceptedAnswer": {"@type": "Answer", "text": "نعم. كلّ من يصطاد في يوتا يحتاج رخصة صيد سارية، وهي متاحة بمدد مختلفة. وتمتدّ Flaming Gorge إلى وايومنغ ولها ترتيب رخص متبادل خاصّ بالبحيرة، وتختلف قواعدها عن Green River أسفل السدّ. وتتغيّر الرخص والحدود واللوائح، فأكّد المتطلّبات الحالية لدى هيئة Utah Division of Wildlife Resources — ولدى Wyoming Game and Fish بشأن Flaming Gorge — قبل أن تصطاد."}},
          {"@type": "Question", "name": "هل يمكن الصيد طوال السنة في أرض الديناصورات؟", "acceptedAnswer": {"@type": "Answer", "text": "نعم، بصور مختلفة. فالصيد في المياه المفتوحة يمتدّ من الربيع إلى الخريف في البحيرات وGreen River، وبحيرات Uinta العالية أفضل ما تكون في الصيف بعد ذوبان الثلج، ويجلب الشتاء الصيد عبر الجليد في Flaming Gorge والبحيرات المنخفضة حين تسمح الأحوال. أكّد دائمًا أحوال الجليد الحالية وسبل الوصول الموسمية قبل أيّ رحلة شتوية."}},
          {"@type": "Question", "name": "ما الأسماك التي يمكن اصطيادها قرب Vernal؟", "acceptedAnswer": {"@type": "Answer", "text": "يقدّم الإقليم تراوت البحيرات، والتراوت البنّي، وتراوت قوس قزح، وسلمون kokanee، والباس صغير الفم في Flaming Gorge؛ وتراوت قوس قزح والتراوت البنّي البرّيين في Green River؛ وتراوت الجداول والتراوت المشقوق الحلق والتراوت النمري وتراوت قوس قزح والغرايلنغ القطبي في بحيرات Uinta؛ وتراوت قوس قزح مع الباس وسمك bluegill في Red Fleet وSteinaker. وتتغيّر الأنواع وبرامج التزويد، فتحقّق من التفاصيل الحالية لدى هيئة Utah Division of Wildlife Resources."}},
          {"@type": "Question", "name": "أيّهما أفضل للصيد: Flaming Gorge أم Green River؟", "acceptedAnswer": {"@type": "Answer", "text": "هما تجربتان مختلفتان. فـFlaming Gorge صيد في بحيرة واسعة، من قارب عادةً، تشتهر بتراوت بحيرات من طراز الأرقام القياسية وتراوت بنّي ضخم. وGreen River أسفل السدّ مياه جارية باردة صافية للصيد بالذبابة لتراوت برّي، تُصاد بالتعويم أو بالخوض. وكثير من الصيادين يجمع بينهما في الرحلة نفسها."}},
          {"@type": "Question", "name": "أين يصطاد المبتدئون والعائلات قرب Vernal؟", "acceptedAnswer": {"@type": "Answer", "text": "بحيرتا Red Fleet وSteinaker أيسر الخيارات وأنسبها للعائلات — قريبتان من البلدة، ودافئتان في الصيف، ويمكن الصيد فيهما من الضفّة دون قارب. وهما مثاليتان لتعريف الأطفال بالصيد، وتقترن كلٌّ منهما طبيعيًّا بالسباحة والتجديف ليوم عائلي كامل."}},
          {"@type": "Question", "name": "هل يمكن الصيد من الضفّة أم يلزم قارب؟", "acceptedAnswer": {"@type": "Answer", "text": "كلاهما ممكن. فـRed Fleet وSteinaker وأجزاء من Flaming Gorge وGreen River تتيح صيدًا منتجًا من الضفّة وبالخوض، وهو مثالي للمبتدئين والعائلات. والقارب يفتح مياه البحيرة الأعمق — وهو ضروري لملاحقة تراوت البحيرات الكبير في Flaming Gorge — ورحلات التعويم هي الطريقة الكلاسيكية لصيد Green River."}},
          {"@type": "Question", "name": "كيف أخطّط لرحلة صيد إلى أرض الديناصورات؟", "acceptedAnswer": {"@type": "Answer", "text": "اتّخذ Vernal قاعدة، ففيها الإقامة والوقود والتموين، ثم اقصد في رحلات يومية المياه التي تناسب هدفك — Flaming Gorge وGreen River شمالًا، وRed Fleet وSteinaker على بعد دقائق من البلدة، وبحيرات Uinta في الجبال. واشترِ رخصة يوتا مسبقًا، وتحقّق من اللوائح الحالية لكلّ مياه، وراجع الطقس، فأحوال الصحراء المرتفعة والجبال تتغيّر بسرعة."}}
        ]
