// ar/itineraries/index.astro — Arabic itineraries hub pillar (AR-2 Phase F batch 6b).
// Mirrors src/pages/itineraries/index.astro. SHAPE B, but the ONE variant in this batch with a
// different component set: no TrustBadge, no HubIndex, and it closes on `GatewayRoutes` instead.
// That is a component swap inside a characterized surface, not a new surface — the prose is still
// inline in the template with no page-content module and no collection read.
//
// ⚠ CORRECTED AFTER MEASUREMENT — a prediction that was wrong. This comment first claimed
// `GatewayRoutes` emits fragments, on the strength of batch 5 measuring 5 of them on
// `from/salt-lake-city`. It does not: that page's fragments came from the trail-route list IT
// passes in, not from the component. Rendered here, `GatewayRoutes` emits city cards with no
// fragment at all — measured 1 fragment on this page, the bare `#` language-switcher toggle, and
// the ENGLISH `/itineraries/` page measures exactly the same 1. Gate 4s held at 2867. **The
// component was never the variable; the data passed to it was.** ADR-12 stays vacuous on shape B.
//
// SLOT 1 — no probe. `13,528` and `5,000` are bare magnitudes beside Arabic unit nouns; `US-40`
// is the measured highway-code class; `Day 1/2/3` are single digits; the phone takes <bdi>.
// The `page-summary` renders (`aria-hidden="false"`) — the 6a rule.
//
// §2.2 — `Dinosaur, Colorado` is a town whose name collides with the monument's; rendered as
// `بلدة Dinosaur في كولورادو` so the disambiguating noun carries the sense, not a bracket.
//
// §4 — every internal target is a registered `ar` route once 6b lands.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GatewayRoutes from '../../../components/content/GatewayRoutes.astro';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Seo from '../../../components/seo/Seo.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../../../lib/i18n';
import { t } from '../../../lib/ui';
const lang = getLangFromUrl(Astro.url);

const schema = `{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": "الدليل الشامل لبرامج الرحلات في أرض الديناصورات",
        "description": "مقرّ تخطيط الرحلات من دليل محلّي لـVernal وأرض الديناصورات — كيف تحوّل يومًا أو يومين أو ثلاثة إلى برنامج رحلة مثالي للعائلات والمغامرين والمصوّرين والصيادين والمخيّمين ومسافري الطرق.",
        "author": {"@type": "Organization", "name": "Adventure Tours Vernal"},
        "publisher": {"@type": "Organization", "name": "Adventure Tours Vernal", "logo": {"@type": "ImageObject", "url": "https://adventuretoursvernal.com/images/logo.webp"}},
        "datePublished": "2026-07-11",
        "dateModified": "2026-07-11",
        "mainEntityOfPage": "https://adventuretoursvernal.com/ar/itineraries/"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {"@type": "Question", "name": "كم يومًا تحتاج في Vernal وأرض الديناصورات؟", "acceptedAnswer": {"@type": "Answer", "text": "يومان إلى ثلاثة هي النقطة المثلى. فيوم واحد يكفي لمعلم رئيسي واحد — Dinosaur National Monument أو جولة UTV مُرشَدة — لكنّه يفرض خيارات صعبة. وعطلة من يومين تغطّي الأساسيات دون عجلة: ديناصورات وفنّ صخري في يوم، ومغامرة برّية والحدائق الحكومية في اليوم التالي. ويفتح اليوم الثالث الرحلات الأكبر — Flaming Gorge، ومرتفعات High Uintas، ورحلة صيد أو تخييم. والرحلات الأطول تتيح التعمّق في موضوع واحد. لائم بين المدّة واهتماماتك ووقت سفرك، وأكّد دائمًا المواعيد والمواسم وسبل الوصول الحالية قبل أن تثبّت خطّة."}},
          {"@type": "Question", "name": "ما أفضل برنامج ليوم واحد قرب Vernal؟", "acceptedAnswer": {"@type": "Answer", "text": "بيوم واحد، اختر مرتكزًا واحدًا وابنِ حوله نصف يوم. والكلاسيكي هو Dinosaur National Monument صباحًا — المحجر وطريق Cub Creek بنقوشه الصخرية — ثم غداء في Vernal وأصيل سهل في حديقة حكومية أو متحف. والنسخة المغامرة تعكسه: جولة UTV مُرشَدة صباحًا في الوديان، ثم النصب أو متحف Utah Field House بعد الظهر. وقاوم رغبة حشر وجهتين كبيرتين في يوم واحد؛ فالإقليم يكافئ العمق لا تعليم الخانات. تحقّق من المواعيد والوصول الموسمي الحالية قبل الذهاب."}},
          {"@type": "Question", "name": "هل أقيم في Vernal أم أتنقّل بين الفنادق؟", "acceptedAnswer": {"@type": "Answer", "text": "في كلّ رحلة تقريبًا، اتّخذ Vernal قاعدة واخرج في رحلات يومية. فالإقليم مبنيّ كعجلة — Vernal هي المحور، والنصب والحدائق الحكومية وFlaming Gorge والغابة كلّها في مدى رحلة يوم، فتوفّر عليك القاعدة الواحدة الحزم وإعادة تسجيل الدخول كلّ ليلة. ولا يصلح التنقّل إلا في رحلة طرق أطول تمضي إلى أقاليم أخرى، أو في رحلة تخييم برّية مخصّصة يكون المخيّم فيها هو المقصد. أكّد توافر الإقامة والمخيّمات الحالي لدى مقدّمي الخدمة قبل أن تلتزم."}},
          {"@type": "Question", "name": "ما أفضل وقت في السنة لرحلة إلى أرض الديناصورات؟", "acceptedAnswer": {"@type": "Answer", "text": "أواخر الربيع وأوائل الخريف هما النقطتان المثاليتان على مستوى الإقليم — حرارة مريحة وحياة برّية نشطة وزحام أخفّ. والصيف مفتوح تمامًا وأفضل لرحلات الماء والمرتفعات، لكنّ الصحراء حارّة فخطّط لبدايات مبكّرة. والخريف يجلب حورًا ذهبيًّا ومسارات هادئة لكن بنافذة تُغلق في الأعلى. والشتاء بارد وهادئ وبعض الطرق والمرافق الموسمية مغلقة، وهو أنسب كرحلة في الصحراء المنخفضة وداخل البلدة. لائم بين برنامجك والموسم: الصحراء والبحيرات في الربيع والخريف، ومرتفعات High Uintas في الصيف. تحقّق من مواعيد الفتح الموسمية قبل التخطيط حول تاريخ."}},
          {"@type": "Question", "name": "هل Vernal مناسبة لرحلة عائلية؟", "acceptedAnswer": {"@type": "Answer", "text": "على نحو استثنائي. فالمعالم الرئيسية أشياء يهتمّ بها الأطفال فعلًا — أحافير ديناصورات حقيقية في الصخر، وآثار أقدام يقفون بجوارها، ووديان، وقوارب — وأكثرها لا يستلزم سوى مسير قصير. والبرنامج العائلي الجيّد يُبقي القيادة قصيرة، ويُدخل الماء ووقت الراحة، ويترك الصحراء المكشوفة لصباحات باردة، ويتيح للأطفال الركوب في جولة UTV مُرشَدة كركّاب. ويومان أو ثلاثة مسترخية خير من يوم واحد مضغوط. أكّد سياسات العمر والمواعيد والمرافق لدى كلّ مقدّم خدمة قبل الذهاب."}},
          {"@type": "Question", "name": "هل يمكن زيارة Vernal في عطلة نهاية أسبوع من Salt Lake City؟", "acceptedAnswer": {"@type": "Answer", "text": "نعم — وهي من أفضل هروب عطلات نهاية الأسبوع من Wasatch Front. فـVernal على نحو ثلاث ساعات قيادة شرق Salt Lake City على طريق US-40 عبر جبال Uinta، قريبة كفاية لتغادر بعد العمل أو باكرًا يوم السبت وتحصل على يومين كاملين على الأرض. اتّخذ Vernal قاعدة، وثبّت العطلة بجولة UTV مُرشَدة وبـDinosaur National Monument، وعُد مساء الأحد. انظر دليلنا للطريق من Salt Lake City إلى Vernal لمعرفة المسار والتوقيت، وتحقّق من أحوال الطرق والطقس الحالية على الممرّات قبل أن تغادر."}},
          {"@type": "Question", "name": "ما الذي ينبغي أن أحجزه أولًا عند تخطيط برنامج في Vernal؟", "acceptedAnswer": {"@type": "Answer", "text": "احجز الأنشطة المرتكزة أولًا وابنِ المعالم المرنة حولها. فجولة UTV المُرشَدة لها مواعيد انطلاق محدّدة، فاحجزها أولًا — وخاصّةً في الصيف وعطلات نهاية الأسبوع — وعاملها النقطة الثابتة في ذلك اليوم. وافعل الشيء نفسه مع أيّ رحلة نهرية أو إقامة أو مخيّم، فهي تُحجز بالكامل في ذروة الموسم. أمّا النصب والحدائق الحكومية والمتاحف والطرق الخلابة فمرنة وتندرج حول مرتكزاتك. احجز مبكّرًا وأكّد التوافر الحالي مباشرةً لدى كلّ مقدّم خدمة."}},
          {"@type": "Question", "name": "ما أفضل برنامج لمسافري المغامرة؟", "acceptedAnswer": {"@type": "Answer", "text": "ينبغي لمسافري المغامرة أن يبنوا الرحلة حول الوصول والارتفاع. ثبّت يومًا على جولة UTV مُرشَدة في بلاد الوديان التي لا تبلغها من طريق معبّد، وأضف مسيرًا نهاريًّا في مرتفعات High Uintas أو امتدادًا من مسار جبلي، وضع فوقه صيدًا أو تجديفًا أو ليلة تخييم لتنام قرب الحدث. وفي الصيف لاحق الهواء البارد في الأعلى؛ وفي المواسم البينيّة اعمل في وديان الصحراء. وهذا إقليم كبير ناءٍ مرتفع — احمل ماءً وخريطة، وأخبر أحدًا بخطّتك، وتحقّق من حالة المسارات والطرق والتصاريح لدى الجهة المشرفة أولًا."}},
          {"@type": "Question", "name": "كيف أخطّط للرحلة المثالية إلى أرض الديناصورات؟", "acceptedAnswer": {"@type": "Answer", "text": "ابدأ بثلاثة أسئلة: كم من الوقت معك، ومع من تسافر، وأيّ موسم هو. اختر مدّة الرحلة، واختر موضوعًا يناسب مجموعتك — عائلة أو مغامرة أو تصوير أو صيد أو تخييم أو قيادة خلابة أو مشي — واتّخذ Vernal قاعدة ليكون كلّ وجهة رحلة يوم. واحجز أنشطتك المرتكزة أولًا، ولائم بين الارتفاع والموسم، واحزم لتقلّبات الصحراء المرتفعة، واقرأ الدليل المخصّص لكلّ وجهة. وأكّد المواعيد والرسوم والمواسم وسبل الوصول الحالية قبل أن تنهي الخطّة، واترك مساحة لتبطئ وتستمتع."}}
        ]
      }
    ]
  }`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="برامج رحلات أرض الديناصورات | مخطّط رحلات Vernal بولاية يوتا"
      description="كيف تخطّط للرحلة المثالية إلى Vernal وأرض الديناصورات — برامج ليوم واحد ولعطلة نهاية الأسبوع ولثلاثة أيام للعائلات والمغامرين والمصوّرين والصيادين ومسافري الطرق."
      path="/ar/itineraries/"
      type="article"
      ogTitle="الدليل الشامل لبرامج الرحلات في أرض الديناصورات"
      ogDescription="مقرّ تخطيط رحلتك إلى Vernal بولاية يوتا — برامج ليوم واحد ولعطلة نهاية الأسبوع ولثلاثة أيام لكلّ نوع من المسافرين، من دليل محلّي."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.itineraries', lang) }]} />

  <p slot="body" class="page-summary" style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="false">الدليل الشامل لبرامج الرحلات في أرض الديناصورات هو مقرّ تخطيط الرحلات إلى Vernal بولاية يوتا وأرض الديناصورات المحيطة بها في شمال شرق يوتا. يساعد الزوّار على تحويل يوم أو يومين أو ثلاثة إلى برنامج رحلة كامل، ويعلّم المسافرين كيف يجمعون معالم الإقليم — Dinosaur National Monument، وجولات UTV المُرشَدة، وFlaming Gorge، وAshley National Forest ومرتفعات High Uintas، وحديقتَي Red Fleet وSteinaker، والنقوش الصخرية، والمتاحف، وصيد الأسماك، والتخييم، والطرق الخلابة — بدل سردها. ويغطّي اختيار مدّة الرحلة؛ وبرامج اليوم الواحد واليومين والثلاثة أيام وعطلة نهاية الأسبوع؛ ورحلات بمواضيع للعائلات ومسافري المغامرة والمصوّرين والصيادين والمخيّمين وسائقي الطرق الخلابة والماشين ومسافري الطرق، إضافةً إلى التخطيط الموسمي، واتّخاذ قاعدة في Vernal أم التنقّل بين الفنادق، وأين تقيم، وماذا تحزم، وكيف ترتّب الحجوزات. أمّا أزمنة القيادة والمواعيد والمواسم وحالة الطرق والمرافق والرسوم والإقامة فتتغيّر وتحدّدها هيئة National Park Service وهيئة U.S. Forest Service وUtah State Parks ومقدّمو الخدمات المحلّيون — تأكّد من المصادر الرسمية. تقدّم Adventure Tours Vernal جولات UTV مُرشَدة بسعر 349 دولارًا للمركبة، حتى راكبين اثنين، 3 ساعات. اتصل على <bdi>(435) 219-9447</bdi>.</p>

  <main class="article-page" slot="body">
    <header class="article-header">
      <h1 class="article-title">الدليل الشامل لبرامج الرحلات في أرض الديناصورات</h1>
      <p class="article-meta">آخر تحديث: يوليو 2026 · Adventure Tours Vernal</p>
    </header>

    <div class="article-body">

      <div class="article-summary-box"><strong>إجابة سريعة:</strong> الناس لا يزورون معالم — بل يخطّطون رحلات. وهذا هو الدليل الذي يحوّل ديناصورات أرض الديناصورات ووديانها وبحيراتها ومناطقها النائية إلى برنامج رحلة واحد حسن الإيقاع. امنح الإقليم <strong>يومين إلى ثلاثة</strong> إن استطعت: فعطلة من يومين تغطّي الأساسيات — ديناصورات وفنّ صخري في يوم، و<a href="/ar/booking/">جولة UTV</a> برّية والحدائق الحكومية في اليوم التالي — ويفتح اليوم الثالث <a href="/ar/guides/ultimate-guide-to-flaming-gorge/">Flaming Gorge</a>، أو <a href="/ar/guides/ultimate-guide-to-ashley-national-forest/">مرتفعات High Uintas</a>، أو رحلة <a href="/ar/fishing/">صيد</a> أو <a href="/ar/camping/">تخييم</a>. اتّخذ <a href="/ar/guides/ultimate-guide-to-vernal-utah/">Vernal</a> قاعدة ليكون كلّ وجهة رحلة يوم، و<strong>احجز أنشطتك المرتكزة أولًا</strong>، ولائم بين الارتفاع والموسم، واحزم لتقلّبات الصحراء المرتفعة. وستجد أدناه برامج جاهزة للاستعمال بحسب المدّة وبحسب الموضوع — عائلة ومغامرة وتصوير وصيد وتخييم وقيادة خلابة ومشي — إضافةً إلى إرشاد موسمي ومنطق التخطيط لتبني برنامجك بنفسك. وأكّد دائمًا المواعيد والرسوم والمواسم وسبل الوصول الحالية قبل أن تنهي خطّتك.</div>

      <div class="key-takeaways">
        <h2>أبرز النقاط</h2>
        <ul>
          <li><strong>يومان إلى ثلاثة هي النقطة المثلى.</strong> فيوم واحد يغطّي معلمًا رئيسيًّا واحدًا؛ وعطلة طويلة ترى الإقليم كلّه دون عجلة؛ والأيام الإضافية تتيح التعمّق في موضوع.</li>
          <li><strong>اتّخذ قاعدة في Vernal.</strong> فالإقليم عجلة — Vernal محورها وكلّ وجهة رحلة يوم، فالقاعدة الواحدة تتفوّق على تبديل الفنادق في كلّ رحلة تقريبًا.</li>
          <li><strong>احجز المرتكزات أولًا.</strong> فجولة UTV المُرشَدة والرحلة النهرية والإقامة أو المخيّمات لها مواعيد ثابتة وتُحجز بالكامل؛ احجزها أولًا وأدرج المعالم المرنة حولها.</li>
          <li><strong>لائم بين الارتفاع والموسم.</strong> فالصحراء والبحيرات تتألّق في الربيع والخريف؛ ومرتفعات High Uintas وجهة صيفية؛ والشتاء رحلة صحراء منخفضة وبلدة.</li>
          <li><strong>اختر موضوعًا، ثم مدّة.</strong> عائلة أو مغامرة أو تصوير أو صيد أو تخييم أو قيادة خلابة أو مشي — لكلٍّ برنامج يناسبه، وهذا الدليل يعطيك كلّها.</li>
          <li><strong>تحقّق من التفاصيل.</strong> فأزمنة القيادة والمواعيد والرسوم ومواعيد الفتح الموسمية وحالة الطرق والإقامة تتغيّر وتحدّدها الجهات ومقدّمو الخدمات — أكّد التفاصيل الحالية قبل أن تثبّت خطّة.</li>
        </ul>
      </div>

      <p>هذه العجلة البسيطة هي الفكرة وراء كلّ برنامج أدناه تقريبًا: Vernal هي المحور، ووجهات الإقليم أذرع في مدى رحلة يوم — ولهذا تتفوّق القاعدة الواحدة على تبديل الفنادق في كلّ رحلة تقريبًا.</p>

      <figure style="margin:2.5rem auto;max-width:820px;text-align:center;">
        <img src="/images/maps/vernal-regional-hub-and-spoke.svg" alt="رسم تخطيطي لمحور وأذرع في أرض الديناصورات، وVernal بولاية يوتا في المركز وخمس وجهات تشعّ منها كأذرع مُعلَّمة — Dinosaur National Monument، وFlaming Gorge، وAshley National Forest، وRed Fleet State Park، وSteinaker State Park. يعرض العلاقات الإقليمية فقط وليس مرسومًا بمقياس رسم ولا مسافة ولا اتجاه بوصلة." width="1600" height="1200" loading="lazy" decoding="async" />
        <figcaption style="margin-top:0.75rem;font-size:0.9rem;line-height:1.6;color:#6E655C;">محور واحد وأذرع كثيرة — الهندسة التي تجعل قاعدة واحدة في Vernal ناجحة. رسم تخطيطي — ليس بمقياس رسم ولا مسافة ولا اتجاه بوصلة.</figcaption>
      </figure>

      <h2>لماذا تخطّط رحلة بدل قائمة</h2>
      <p>أكثر أدلّة السفر تناولك قائمة معالم وتتمنّى لك التوفيق. وليست هكذا تحدث الرحلات الجيّدة. فالرحلة الرائعة إلى أرض الديناصورات ليست قائمة محطّات — إنّها <em>تسلسل</em>: الأشياء الصحيحة بالترتيب الصحيح في الوقت الصحيح من اليوم ومن السنة، مثبّتة حول الأنشطة التي عليك حجزها ومحشوّة بالمرنة التي يمكنك تحريكها. أصِب التسلسل تشعر أنّ عطلة من يومين وفيرة؛ وأخطئه يشعر الأسبوع بالعجلة.</p>
      <p>وهذا مقرّ تخطيطك. فلكلّ نشاط في الإقليم الآن دليله المعمّق — <a href="/ar/dinosaur-national-monument/">Dinosaur National Monument</a>، وجولات <a href="/ar/utv/">UTV</a> المُرشَدة، و<a href="/ar/fishing/">صيد الأسماك</a>، و<a href="/ar/camping/">التخييم</a>، و<a href="/ar/scenic-drives/">الطرق الخلابة</a>، و<a href="/ar/hiking/">المشي في الطبيعة</a>، و<a href="/ar/things-to-do/">كلّ ما يمكن فعله غير ذلك</a>. وهذه الصفحة تؤدّي ما لا يؤدّيه أيّ منها وحده: تعلّمك كيف <strong>تجمعها</strong> في رحلة تناسب أيامك ومسافريك وموسمك. اقرأها من أوّلها إلى آخرها لتفهم المنطق، أو انتقل إلى المدّة أو الموضوع الذي يناسب رحلتك وارفع البرنامج من الصفحة مباشرةً.</p>
      <p>وملاحظة صادقة واحدة في البداية، وستراها مكرّرة: <em>شكل</em> هذه البرامج يثبت من موسم إلى موسم، لكنّ التفاصيل — المواعيد بالضبط والرسوم ومواعيد فتح الطرق الموسمية وتوافر المخيّمات والإقامة — تحدّدها هيئة National Park Service وهيئة U.S. Forest Service وUtah State Parks ومقدّمو الخدمات المحلّيون، وهي تتغيّر. عامل كلّ خطّة هنا نقطةَ انطلاق ذكية، و<strong>أكّد التفاصيل الحالية</strong> قبل أن تلتزم.</p>

      <p>وقبل أن تستقرّ على مدّة، يفيدك أن تعرف حول ماذا تبني الرحلة. استعن بالمُنتقي أدناه للانتقال من اهتمام إلى تجربة — ثم لائمها بأحد البرامج الجاهزة التي تليه.</p>

      <figure style="margin:2.5rem auto;max-width:820px;text-align:center;">
        <img src="/images/graphics/vernal-adventure-decision-tree.svg" alt="رسم شجرة قرار لاختيار رحلة في أرض الديناصورات بحسب الاهتمام. جذر يسأل «ما الذي تميل إليه؟» يتفرّع إلى أربعة اهتمامات — رؤية المعالم الأيقونية، والحركة والنشاط، والاستمتاع على وتيرتك، والسفر مع الأطفال — تقود إلى سبع تجارب: الديناصورات، ومغامرة UTV، والمشي، وصيد الأسماك، والطرق الخلابة، والتصوير، وأنشطة العائلة، ولكلٍّ دليلها. يقرن الاهتمامات بالتجارب بوصفه أداة تخطيط لا قاعدة." width="1600" height="1200" loading="lazy" decoding="async" />
        <figcaption style="margin-top:0.75rem;font-size:0.9rem;line-height:1.6;color:#6E655C;">اختر التجربة التي تشدّك أكثر، ثم اختر برنامجًا مناسبًا أدناه بحسب المدّة أو الموضوع. أداة تخطيط — وأفضل الرحلات كثيرًا ما تمزج عدّة تجارب.</figcaption>
      </figure>

      <h2>اختيار مدّة رحلتك</h2>
      <p>أنفع قرار تخطيطي منفرد هو كم يومًا تمنح الإقليم — وكلّ ما عداه يتبعه. فأرض الديناصورات تفوق حجمها بكثير، حتى إنّ رحلة قصيرة تستحقّ، لكنّ كلّ يوم إضافي يفتح طبقة مختلفة حقًّا من الإقليم. وهكذا تفكّر في الأمر.</p>
      <div class="table-scroll">
        <table>
          <thead>
            <tr><th>المدّة</th><th>لماذا تصلح</th><th>المقابل بصدق</th></tr>
          </thead>
          <tbody>
            <tr><td>يوم واحد</td><td>معلم رئيسي واحد يُؤدّى جيّدًا — النصب أو جولة UTV — في محطّة على رحلة طرق أو يوم من قاعدة قريبة</td><td>يفرض خيارًا صعبًا؛ ولا وقت لمدى الإقليم</td></tr>
            <tr><td>يومان — عطلة نهاية أسبوع</td><td>الأساسيات دون عجلة: ديناصورات وفنّ صخري، مع مغامرة برّية والحدائق الحكومية</td><td>يترك الرحلات الأكبر — Flaming Gorge والمرتفعات — لـ"المرّة القادمة"</td></tr>
