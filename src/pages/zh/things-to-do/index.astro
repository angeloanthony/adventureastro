---
// zh/things-to-do/index.astro — Simplified Chinese Things to Do hub pillar
// (Z4 Chinese inline batch, mirrors src/pages/ja/things-to-do/index.astro,
// which in turn mirrors the DE/PT/FR/IT/ES/English originals).
//
// NOTE: like its JA/DE/PT/FR/IT/ES siblings, this route file is NOT
// locale-agnostic boilerplate — it carries its own hardcoded, per-locale Seo
// title/description/ogDescription and Article+FAQPage JSON-LD, translated
// from the English source. It is authored directly rather than copied from
// ja/, because copying would have shipped Japanese meta tags and schema on a
// Chinese URL.
import { getBodyHtml } from '../../../page-content/things-to-do';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../config/site';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Seo from '../../../components/seo/Seo.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import HubIndex from '../../../components/content/HubIndex.astro';
import { getLangFromUrl } from '../../../lib/i18n';
import { t } from '../../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
// Cornerstone Article + expanded FAQ structured data. Mirrors the
// English/Italian/Portuguese/French/German/Japanese schema graph; author kept
// as Organization to match the pillar's existing entity. FAQPage mirrors the
// visible FAQ below verbatim.
const schema = `{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": "犹他州 Vernal 的玩法——完整的本地攻略",
        "description": "一位本地向导为犹他州 Vernal 的玩法给出的完整计划——Dinosaur National Monument、导览 UTV 行程、岩画、景观自驾、州立公园、餐馆、季节建议，以及现成的行程。",
        "author": {"@type": "Organization", "name": "Adventure Tours Vernal"},
        "publisher": {"@type": "Organization", "name": "Adventure Tours Vernal", "logo": {"@type": "ImageObject", "url": "https://adventuretoursvernal.com/images/logo.webp"}},
        "datePublished": "2026-04-08",
        "dateModified": "2026-07-10",
        "mainEntityOfPage": "https://adventuretoursvernal.com/zh/things-to-do/"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {"@type": "Question", "name": "在犹他州 Vernal 最值得做的事有哪些？", "acceptedAnswer": {"@type": "Answer", "text": "在 Vernal 最值得做的事是一趟导览荒野 UTV 行程，参观 Dinosaur National Monument 及其 Wall of Bones，在 McConkie Ranch 和 Dry Fork Canyon 观赏 Fremont 岩画，在 Red Fleet State Park 走一走恐龙足迹，逛 Utah Field House of Natural History 的恐龙园，以及在 Steinaker、Red Fleet 和 Flaming Gorge 钓鱼或划船。"}},
          {"@type": "Question", "name": "在犹他州 Vernal 需要待几天？", "acceptedAnswer": {"@type": "Answer", "text": "两到三天最理想。一天留给 Dinosaur National Monument 和岩画，一天留给导览 UTV 行程和州立公园，再用可选的第三天去 Flaming Gorge、钓鱼，或在 Uinta Mountains 徒步。仅一天只够看纪念地或另一项头牌活动。"}},
          {"@type": "Question", "name": "犹他州 Vernal 值得一去吗？", "acceptedAnswer": {"@type": "Answer", "text": "值得。Vernal 是通往 Dinosaur National Monument 的门户，把真正的恐龙化石、远古岩画、红岩峡谷、西部拓荒历史和世界级的户外休闲，都装进了一个狭小、不拥挤的半径里。它把吸引人们前往犹他州南部的许多东西都给了你，却没有拥挤的人群。"}},
          {"@type": "Question", "name": "在 Vernal 最值得做的头号事情是什么？", "acceptedAnswer": {"@type": "Answer", "text": "跟随 Adventure Tours Vernal 的一趟导览荒野 UTV 行程，是最能身临其境的单项活动——它把越野冒险、岩画、天然拱门，以及你从铺装公路无法抵达的峡谷风光，合成一段三小时的体验。Dinosaur National Monument 则是头号必看景点。"}},
          {"@type": "Question", "name": "犹他州 Vernal 适合带孩子的家庭吗？", "acceptedAnswer": {"@type": "Answer", "text": "非常适合。孩子可以在 Dinosaur National Monument 触摸真正的恐龙化石，在 Red Fleet State Park 走到恐龙足迹跟前，逛 Utah Field House 的恐龙园，还能在家长陪同下从 2 岁起作为乘客同乘一趟导览 UTV 行程。大多数亮点都只需走几步路。"}},
          {"@type": "Question", "name": "一年中到访犹他州 Vernal 的最佳时节是什么时候？", "acceptedAnswer": {"@type": "Answer", "text": "晚春（5—6 月）和初秋（9—10 月）气温最宜人、野生动物活跃、人流较稀。夏天温暖，全面开放，最适合水上活动。冬天安静而景色优美，但寒冷，部分季节性设施和道路会关闭。"}},
          {"@type": "Question", "name": "Vernal 距 Salt Lake City 有多远？", "acceptedAnswer": {"@type": "Answer", "text": "Vernal 在 Salt Lake City 以东、沿 US-40 约三小时车程，Salt Lake City 是最近的大型机场。风景优美的路线翻越 Uinta Mountains，穿过 Daniels Summit 和 Strawberry Reservoir 一带。"}},
          {"@type": "Question", "name": "犹他州 Vernal 以什么闻名？", "acceptedAnswer": {"@type": "Answer", "text": "Vernal 以犹他州的恐龙之乡闻名。它位于 Uintah Basin 中 Dinosaur National Monument 的边缘，四周环绕着红岩峡谷、Fremont 和 Ute 岩画、西部拓荒时代的无法之徒历史，以及公有土地上的户外休闲。"}},
          {"@type": "Question", "name": "到访 Vernal 需要开车吗？", "acceptedAnswer": {"@type": "Answer", "text": "需要。Vernal 的景点分散在四周乡野——纪念地在东面 20 分钟，州立公园和峡谷在 5 到 60 分钟车程外——彼此之间没有完善的公共交通，因此私家车必不可少。一旦上了越野路线，导览 UTV 行程会负责代步。"}},
          {"@type": "Question", "name": "Vernal 是 Moab 的好替代选择吗？", "acceptedAnswer": {"@type": "Answer", "text": "对许多旅行者来说，是的。Vernal 提供红岩峡谷、越野冒险，以及神韵上与 Moab 相近的壮丽风光，但人流少得多，还有 Moab 无法比拟的恐龙化石和岩画。对想要冒险又不想拥堵的游客来说，它是一个有力的选择。"}}
        ]
      }
    ]
  }`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="犹他州 Vernal 的玩法｜热门活动与景点"
      description="犹他州 Vernal 的玩法，由本地向导为你介绍。导览 UTV 行程、Dinosaur National Monument、徒步、钓鱼、岩画、景观自驾、州立公园，以及季节推荐和 2—3 天的示范行程。今天就规划你的 Vernal 冒险。"
      path="/zh/things-to-do/"
      type="article"
      ogDescription="发现犹他州 Vernal 最值得做的事——从导览 UTV 行程，到恐龙化石、岩画，以及 Uintah Basin 的户外休闲。"
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="things-to-do" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('hub.things-to-do', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <HubIndex slot="body" collection="things-to-do" heading="Vernal 玩法攻略一览" />
  <Footer slot="body" variant="compact" />
</BaseLayout>
