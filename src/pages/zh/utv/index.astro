---
// zh/utv/index.astro — Simplified Chinese UTV landing page (Z4 inline pass,
// informal 你 register). Mirrors src/pages/ja/utv/index.astro structurally,
// which in turn mirrors src/pages/utv/index.astro.
//
// The Chinese UTV spoke articles already exist as translated MDX by the time
// this pillar lands (see ZH_SLUGS in src/lib/i18n.ts) — so HubIndex's `utv`
// collection read will surface Chinese titles/links here once locale is
// 'zh', with no change needed to HubIndex itself.
import { getBodyHtml } from '../../../page-content/utv';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { SITE } from '../../../config/site';
import Header from '../../../components/layout/Header.astro';
import Footer from '../../../components/layout/Footer.astro';
import Seo from '../../../components/seo/Seo.astro';
import Breadcrumbs from '../../../components/layout/Breadcrumbs.astro';
import HubIndex from '../../../components/content/HubIndex.astro';
import TourDecisionGuide from '../../../components/content/TourDecisionGuide.astro';
import { getLangFromUrl } from '../../../lib/i18n';
import { t } from '../../../lib/ui';
const lang = getLangFromUrl(Astro.url);
const bodyHtml = getBodyHtml(lang);
const schema = `
  {
    "@context": "https://schema.org",
    "@type": "TouristAttraction",
    "name": "UTV 越野路线导览游 — Adventure Tours Vernal",
    "description": "Vernal，犹他州 附近的 UTV 导览游。越野路线包括 Doc's Beach、Moonshine Arch、Ashley Gorge、Outlaw Trail 和 Asphalt Ridge。岩画、野生动物（包括金雕、白头海雕、鹿和美洲狮），以及开阔的观景点。",
    "url": "https://adventuretoursvernal.com/zh/utv/",
    "image": "https://adventuretoursvernal.com/images/Docs%20Beach.webp",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Adventure Tours Vernal",
      "telephone": "+1-435-219-9447",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "1935 S 1500 E",
        "addressLocality": "Vernal",
        "addressRegion": "UT",
        "postalCode": "84078",
        "addressCountry": "US"
      }
    }
  }
`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="Vernal，犹他州的 UTV 越野路线导览游 | Adventure Tours Vernal"
      description="探索 Vernal，犹他州 附近的 Kawasaki KRX 1000 UTV 越野路线导览游——Doc's Beach、Moonshine Arch、Ashley Gorge、Outlaw Trail 和 Asphalt Ridge。致电 (435) 219-9447。"
      path="/zh/utv/"
      type="website"
      image="https://adventuretoursvernal.com/images/Docs%20Beach.webp"
      ogTitle="UTV 越野路线导览游 | Adventure Tours Vernal"
      ogDescription="Vernal，犹他州 附近的五条 UTV 越野路线导览游。雄鹰、岩画、峡谷和令人叹为观止的风景。致电 (435) 219-9447。"
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="trails" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.trails', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <TourDecisionGuide slot="body" />
  <HubIndex slot="body" collection="utv" heading="所有 UTV 越野路线攻略" />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.ourTrails', lang),
      // Trail names are place names — kept verbatim, never translated.
      links: [
        { href: '/utv/', label: "Doc's Beach" },
        { href: '/utv/', label: 'Moonshine Arch' },
        { href: '/utv/', label: 'Ashley Gorge' },
        { href: '/utv/', label: 'Outlaw Trail' },
        { href: '/utv/', label: 'Asphalt Ridge' },
      ],
    }}
    contact={{ heading: t('footer.contactInfo', lang) }}
  />
</BaseLayout>
