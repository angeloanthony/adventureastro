---
import { bodyHtml } from '../page-content/privacy';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import Seo from '../components/seo/Seo.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { getLangFromUrl } from '../lib/i18n';
import { t } from '../lib/ui';
const lang = getLangFromUrl(Astro.url);
---
<BaseLayout bodyClass="policy-page-body">
  <Fragment slot="head">
    <Seo
      title="Privacy Policy | Adventure Tours Vernal"
      description="Privacy policy for Adventure Tours Vernal in Vernal, Utah. How we collect, use, and protect your information when you book a guided UTV tour. Call (435) 219-9447."
      path="/privacy-policy/"
      type="website"
      ogDescription="How Adventure Tours Vernal collects, uses, and protects your information when you book a guided UTV tour in Vernal, Utah."
    />
  </Fragment>
  <Header slot="body" active="privacy-policy" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('nav.privacyPolicy', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    trails={{
      heading: t('footer.quickLinks', lang),
      links: [
        { href: '/utv/', label: t('footer.link.ourTours', lang) },
        { href: '/#vehicles', label: t('footer.link.ourFleet', lang) },
        { href: '/#gallery', label: t('footer.link.photoGallery', lang) },
        { href: '/booking/', label: t('cta.bookNow', lang) },
      ],
    }}
    contact={{ showStreet: false }}
    info={{
      heading: t('footer.information', lang),
      links: [
        { href: '/cancellation-policy/', label: t('nav.cancellationPolicy', lang) },
        { href: '/privacy-policy/', label: t('nav.privacyPolicy', lang) },
        { href: '/faq/', label: t('nav.faq', lang) },
        { href: '/safety-guidelines/', label: t('nav.safetyGuidelines', lang) },
      ],
    }}
  />
</BaseLayout>
