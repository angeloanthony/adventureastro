---
import { bodyHtml } from '../../page-content/dnm';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import HubIndex from '../../components/content/HubIndex.astro';
const schema = `{"@context":"https://schema.org","@graph":[{"@type":"Article","headline":"UTV Tours Near Dinosaur National Monument","description":"Guided UTV tours in the backcountry surrounding Dinosaur National Monument, Vernal, Utah.","author":{"@type":"Organization","name":"Adventure Tours Vernal"},"publisher":{"@type":"Organization","name":"Adventure Tours Vernal","logo":{"@type":"ImageObject","url":"https://adventuretoursvernal.com/images/logo.webp"}},"datePublished":"2026-04-08","dateModified":"2026-04-08","mainEntityOfPage":"https://adventuretoursvernal.com/dinosaur-national-monument/"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can you do UTV tours near Dinosaur National Monument?","acceptedAnswer":{"@type":"Answer","text":"Yes. Adventure Tours Vernal operates guided Kawasaki KRX 1000 tours through the backcountry surrounding the monument. While motorized vehicles aren't allowed inside the monument, the trails just outside feature the same canyon terrain, petroglyphs, and geological formations."}},{"@type":"Question","name":"How far is Adventure Tours Vernal from Dinosaur National Monument?","acceptedAnswer":{"@type":"Answer","text":"Adventure Tours Vernal is based in Vernal, Utah, approximately 20 minutes west of the monument's Quarry Exhibit Hall. Many visitors pair a UTV tour with a monument visit on the same trip."}},{"@type":"Question","name":"What's the best way to combine a UTV tour with Dinosaur National Monument?","acceptedAnswer":{"@type":"Answer","text":"Book your UTV tour for the morning and visit the monument in the afternoon, or vice versa. A 3-hour guided UTV tour plus a half-day at the monument makes a full day of canyon country adventure."}}]}]}`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="UTV Tours Near Dinosaur National Monument | Adventure Tours Vernal"
      description="Guided UTV tours near Dinosaur National Monument in Vernal, Utah. Explore backcountry canyons, petroglyphs, and desert terrain just minutes from the monument. Book today."
      path="/dinosaur-national-monument/"
      type="article"
      ogTitle="UTV Tours Near Dinosaur National Monument"
      ogDescription="Guided Kawasaki KRX 1000 tours through the backcountry surrounding Dinosaur National Monument — canyons, petroglyphs, and desert adventure."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="dinosaur-national-monument" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: 'Dinosaur Monument Tours' }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <HubIndex slot="body" collection="dinosaur-national-monument" heading="All Dinosaur Monument Guides" />
  <Footer slot="body" variant="compact" />
</BaseLayout>
