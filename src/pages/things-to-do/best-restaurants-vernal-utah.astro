const restaurantListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Restaurants in Vernal, Utah Recommended by Adventure Tours Vernal',
  itemListElement: restaurants.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'Restaurant',
      name: r.name,
      servesCuisine: r.cuisine,
      telephone: r.phone,
      address: {
        '@type': 'PostalAddress',
        streetAddress: r.street,
        addressLocality: r.city,
        addressRegion: r.state,
        postalCode: r.zip,
        addressCountry: 'US',
      },
      ...(r.url ? { url: r.url } : {}),
    },
  })),
};
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="Best Restaurants in Vernal Utah | Adventure Tours Vernal"
      description="Discover the best restaurants in Vernal, Utah — from local diners and steakhouses to Mexican favorites. Adventure Tours guests get exclusive dining discounts with coupon codes at top Vernal restaurants."
      path="/things-to-do/best-restaurants-vernal-utah/"
      type="article"
      image="https://adventuretoursvernal.com/images/95a.webp"
      ogDescription="Discover the best restaurants in Vernal, Utah. Adventure Tours guests get exclusive dining discounts with coupon codes."
    />
    <meta name="keywords" content="best restaurants Vernal Utah, where to eat Vernal Utah, Vernal Utah restaurants, dining near Dinosaur National Monument, restaurants near Flaming Gorge, Vernal food guide">
    <meta name="ai-content-summary" content="Interactive guide to the best restaurants in Vernal, Utah, with category filters, exclusive coupon codes for Adventure Tours guests, phone numbers, website links, and Google Maps links. Categories: casual/pizza, diners and breakfast, steakhouses and Western dining, Mexican and international. Each restaurant card includes an exclusive discount code with a Show to Server mobile coupon feature.">
    <Fragment set:html={restaurantStyles} />
    <script type="application/ld+json" set:html={schema} />
    <script type="application/ld+json" set:html={JSON.stringify(restaurantListJsonLd)} />
  </Fragment>
  <Header slot="body" active="food" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: 'Best Restaurants' }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <Footer
    slot="body"
    tagline="Guided UTV tours through Vernal, Utah's most stunning desert landscapes, ancient petroglyphs, and red rock canyons."
    logoHeight={80}
    brandPhone
    showSocial={false}
    contact={false}
    columns={[
      {
        heading: 'Explore',
        links: [
          { href: '/', label: 'Home' },
          { href: '/utv/', label: 'Tours & Trails' },
          { href: '/booking/', label: 'Book a Tour' },
          { href: '/about/', label: 'About Us' },
          { href: '/faq/', label: 'FAQ' },
        ],
      },
      {
        heading: 'Visitor Resources',
        links: [
          { href: '/things-to-do/best-restaurants-vernal-utah/', label: 'Best Restaurants in Vernal' },
          { href: '/utv/best-utv-trails-vernal/', label: 'Best UTV Trails' },
          { href: '/dinosaur-national-monument/petroglyphs-rock-art-vernal/', label: 'Petroglyphs & Rock Art' },
          { href: '/guides/vernal-weather-guide/', label: 'Vernal Weather Guide' },
          { href: '/guides/what-to-wear-utv-tour/', label: 'What to Wear' },
          { href: '/guides/what-to-bring/', label: 'What to Bring' },
        ],
      },
      {
        heading: 'Policies',
        links: [
          { href: '/safety-guidelines/', label: 'Safety Guidelines' },
          { href: '/cancellation-policy/', label: 'Cancellation Policy' },
          { href: '/privacy-policy/', label: 'Privacy Policy' },
        ],
      },
    ]}
    copyright={{ prefix: '2026 Adventure Tours Vernal. All rights reserved. Vernal, Utah.', linkText: undefined, linkHref: undefined, suffix: '' }}
  />
</BaseLayout>
