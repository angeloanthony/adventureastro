---
import { bodyHtml } from '../../page-content/things-to-do';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../config/site';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import Seo from '../../components/seo/Seo.astro';
import Breadcrumbs from '../../components/layout/Breadcrumbs.astro';
import HubIndex from '../../components/content/HubIndex.astro';
import { getLangFromUrl } from '../../lib/i18n';
import { t } from '../../lib/ui';
const lang = getLangFromUrl(Astro.url);
// Cornerstone Article + expanded FAQ structured data. Author kept as
// Organization to match the pillar's existing entity (per the deferred
// schema-component Open Decision); dateModified bumped for the Phase-4
// cornerstone rewrite. FAQPage mirrors the visible FAQ below verbatim.
const schema = `{
    "@context": "https://schema.org",
    "@graph": [
      {
        "@type": "Article",
        "headline": "Things to Do in Vernal, Utah — The Complete Local Guide",
        "description": "A local guide's complete plan for things to do in Vernal, Utah — Dinosaur National Monument, guided UTV tours, petroglyphs, scenic drives, state parks, restaurants, seasonal advice, and ready-made itineraries.",
        "author": {"@type": "Organization", "name": "Adventure Tours Vernal"},
        "publisher": {"@type": "Organization", "name": "Adventure Tours Vernal", "logo": {"@type": "ImageObject", "url": "https://adventuretoursvernal.com/images/logo.webp"}},
        "datePublished": "2026-04-08",
        "dateModified": "2026-07-10",
        "mainEntityOfPage": "https://adventuretoursvernal.com/things-to-do/"
      },
      {
        "@type": "FAQPage",
        "mainEntity": [
          {"@type": "Question", "name": "What are the best things to do in Vernal, Utah?", "acceptedAnswer": {"@type": "Answer", "text": "The best things to do in Vernal are a guided backcountry UTV tour, visiting Dinosaur National Monument and its Wall of Bones, viewing Fremont petroglyphs at McConkie Ranch and Dry Fork Canyon, walking the dinosaur trackways at Red Fleet State Park, the Utah Field House of Natural History dinosaur garden, and fishing or boating at Steinaker, Red Fleet, and Flaming Gorge."}},
          {"@type": "Question", "name": "How many days do you need in Vernal, Utah?", "acceptedAnswer": {"@type": "Answer", "text": "Two to three days is ideal. One day for Dinosaur National Monument and petroglyphs, one day for a guided UTV tour and the state parks, and an optional third day for Flaming Gorge, fishing, or hiking in the Uinta Mountains. A single day only allows time for the monument or one other headline activity."}},
          {"@type": "Question", "name": "Is Vernal, Utah worth visiting?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Vernal is the gateway to Dinosaur National Monument and packs real dinosaur fossils, ancient rock art, red-rock canyons, Wild West history, and world-class outdoor recreation into a small, uncrowded radius. It offers much of what draws people to southern Utah without the crowds."}},
          {"@type": "Question", "name": "What is the number one thing to do in Vernal?", "acceptedAnswer": {"@type": "Answer", "text": "A guided backcountry UTV tour with Adventure Tours Vernal is the single most immersive activity — it combines off-road adventure, petroglyphs, natural arches, and canyon scenery you cannot reach from a paved road into one three-hour experience. Dinosaur National Monument is the top must-see attraction."}},
          {"@type": "Question", "name": "Is Vernal, Utah good for families with kids?", "acceptedAnswer": {"@type": "Answer", "text": "Very. Kids can touch real dinosaur fossils at Dinosaur National Monument, walk up to dinosaur trackways at Red Fleet State Park, explore the Utah Field House dinosaur garden, and ride along on a guided UTV tour as passengers from age 2 with a parent. Most highlights involve only short walks."}},
          {"@type": "Question", "name": "What is the best time of year to visit Vernal, Utah?", "acceptedAnswer": {"@type": "Answer", "text": "Late spring (May–June) and early fall (September–October) offer the most comfortable temperatures, active wildlife, and thinner crowds. Summer is warm, fully open, and best for water activities. Winter is quiet and scenic but cold, with some seasonal facilities and roads closed."}},
          {"@type": "Question", "name": "How far is Vernal from Salt Lake City?", "acceptedAnswer": {"@type": "Answer", "text": "Vernal is roughly a three-hour drive east of Salt Lake City on US-40, and Salt Lake City is the nearest major airport. The scenic route climbs over the Uinta Mountains and through Daniels Summit and Strawberry Reservoir country."}},
          {"@type": "Question", "name": "What is Vernal, Utah known for?", "acceptedAnswer": {"@type": "Answer", "text": "Vernal is known as Utah's Dinosaur Country. It sits at the edge of Dinosaur National Monument in the Uintah Basin, surrounded by red-rock canyons, Fremont and Ute petroglyphs, Wild West outlaw history, and outdoor recreation on public land."}},
          {"@type": "Question", "name": "Do you need a car to visit Vernal?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Vernal's attractions are spread across the surrounding countryside — the monument is 20 minutes east, the state parks and canyons are 5 to 60 minutes out — and there is no comprehensive public transit between them, so a personal vehicle is essential. Guided UTV tours provide transport once you are on the trail."}},
          {"@type": "Question", "name": "Is Vernal a good alternative to Moab?", "acceptedAnswer": {"@type": "Answer", "text": "For many travelers, yes. Vernal offers red-rock canyons, off-road adventure, and dramatic scenery similar in spirit to Moab, but with far fewer crowds, plus dinosaur fossils and petroglyphs that Moab cannot match. It is a strong choice for visitors who want adventure without the congestion."}}
        ]
      }
    ]
  }`;
---
<BaseLayout>
  <Fragment slot="head">
    <Seo
      title="Things to Do in Vernal, Utah | Top Activities & Attractions"
      description="The best things to do in Vernal, Utah — guided UTV tours, Dinosaur National Monument, hiking, fishing, petroglyphs, and more. Plan your Vernal adventure today."
      path="/things-to-do/"
      type="article"
      ogDescription="Discover the best activities in Vernal, Utah — from guided UTV tours to dinosaur fossils, rock art, and outdoor recreation in the Uintah Basin."
    />
    <script type="application/ld+json" set:html={schema} />
  </Fragment>
  <Header slot="body" active="things-to-do" />
  <Breadcrumbs slot="body" schemaOnly items={[{ label: t('hub.things-to-do', lang) }]} />
  <Fragment slot="body" set:html={bodyHtml} />
  <HubIndex slot="body" collection="things-to-do" heading="All Things to Do Guides" />
  <Footer slot="body" variant="compact" />
</BaseLayout>
