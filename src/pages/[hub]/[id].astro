---
// [hub]/[id].astro — the ENGLISH spoke route (Phase 2.6 framework; P4A
// locale split). Renders every non-draft *English* entry of every hub
// collection at /hub/id/ via SpokeArticle. Translated entries (id carries a
// locale suffix, e.g. `article.es`) are emitted by the sibling
// src/pages/[locale]/[hub]/[id].astro route instead — see that file. Rendering
// lives in components/routing/SpokeArticle.astro so both routes stay in sync.
// Draft entries are excluded here AND in sitemap-articles.xml.ts — a draft
// must never reach dist. URL shape comes exclusively from src/lib/hubs.ts.
import { getCollection } from 'astro:content';
import SpokeArticle from '../../components/routing/SpokeArticle.astro';
import { HUB_SLUGS, type HubSlug } from '../../lib/hubs';
import { parseEntryLocale, DEFAULT_LOCALE } from '../../lib/i18n';
import type { SpokeData } from '../../content.config';

type SpokeEntry = { id: string; data: SpokeData; [key: string]: unknown };

export async function getStaticPaths() {
  const paths = [];
  for (const hub of HUB_SLUGS) {
    const entries = (await getCollection(hub)) as unknown as SpokeEntry[];
    for (const entry of entries.filter((e) => !e.data.draft)) {
      if (parseEntryLocale(entry.id).locale !== DEFAULT_LOCALE) continue; // localized → [locale]/ route
      paths.push({ params: { hub, id: entry.id }, props: { entry, hub } });
    }
  }
  return paths;
}

interface Props { entry: SpokeEntry; hub: HubSlug }
const { entry, hub } = Astro.props;
---
<SpokeArticle entry={entry} hub={hub} />
