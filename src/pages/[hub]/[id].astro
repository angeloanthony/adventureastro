---
// [hub]/[id].astro — the ONE spoke route (Phase 2.6 framework). Renders
// every non-draft entry of every hub collection through SpokeLayout;
// emits zero pages while collections are empty, so activating it
// publishes nothing. Draft entries are excluded here AND in
// sitemap-articles.xml.ts — a draft must never reach dist.
// URL shape comes exclusively from src/lib/hubs.ts (G2 change point).
import { getCollection, render } from 'astro:content';
import SpokeLayout from '../../layouts/SpokeLayout.astro';
import { HUB_SLUGS, HUBS, pillarHref, spokeHref, type HubSlug } from '../../lib/hubs';
import type { SpokeData } from '../../content.config';

type SpokeEntry = { id: string; data: SpokeData; [key: string]: unknown };

export async function getStaticPaths() {
  const paths = [];
  for (const hub of HUB_SLUGS) {
    const entries = (await getCollection(hub)) as unknown as SpokeEntry[];
    for (const entry of entries.filter((e) => !e.data.draft)) {
      paths.push({ params: { hub, id: entry.id }, props: { entry, hub } });
    }
  }
  return paths;
}

interface Props { entry: SpokeEntry; hub: HubSlug }
const { entry, hub } = Astro.props;
// eslint-disable-next-line @typescript-eslint/no-explicit-any
const { Content } = await render(entry as any);
const d = entry.data;
---
<SpokeLayout
  title={d.title}
  description={d.description}
  path={spokeHref(hub, entry.id)}
  heroImage={d.heroImage}
  author={d.author}
  publishDate={d.publishDate}
  updatedDate={d.updatedDate}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: HUBS[hub].name, href: pillarHref(hub) },
    { label: d.title },
  ]}
  collection={hub}
  currentId={entry.id}
  tags={d.tags}
  related={d.related}
  tourCta={d.tourCta}
  faq={d.faq}
  ogTitle={d.ogTitle}
  ogDescription={d.ogDescription}
>
  <Content />
</SpokeLayout>
