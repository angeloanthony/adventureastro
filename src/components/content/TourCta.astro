---
// TourCta.astro — the booking CTA block (Build Guide §4.5, §9.1).
// Pulls pricing from SITE config so a single edit updates every page.
// The `?? 'Call for pricing'` fallback is kept defensively in case
// SITE.pricing.baseTour is ever unset again. Never render more than 2 of
// these on one page.
import { SITE } from '../../config/site';
import { getLangFromUrl } from '../../lib/i18n';
import { t } from '../../lib/ui';

interface Props {
  variant?: 'family' | 'adventure' | 'sunset' | 'generic';
  valueProp?: string;
}

const lang = getLangFromUrl(Astro.url);
const VALUE_PROPS: Record<string, string> = {
  family: t('tour.value.family', lang),
  adventure: t('tour.value.adventure', lang),
  sunset: t('tour.value.sunset', lang),
  generic: t('tour.value.generic', lang),
};

const { variant = 'generic', valueProp = VALUE_PROPS[variant] } = Astro.props;
const priceDisplay = SITE.pricing.baseTour != null ? `$${SITE.pricing.baseTour}/machine` : null;
---
<div class={`tour-cta tour-cta-${variant}`}>
  <p class="tour-cta-value-prop">{valueProp}</p>
  <p class="tour-cta-details">
    {priceDisplay ?? t('tour.callForPricing', lang)} &middot; {t('tour.threeHours', lang)} &middot; {t('tour.upToRiders', lang, { n: SITE.fleet.seatsPerMachine })}
  </p>
  <a href={SITE.booking.path} class="tour-cta-button">{t('cta.bookYourAdventure', lang)}</a>
</div>

<style>
  .tour-cta {
    max-width: 720px;
    margin: 40px auto;
    padding: 32px 24px;
    text-align: center;
    background: linear-gradient(135deg, var(--burnt-orange, #d4764e), #b85c38);
    border-radius: 16px;
    color: #fff;
  }
  .tour-cta-value-prop {
    font-size: 1.3rem;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .tour-cta-details {
    margin: 0 0 20px;
    opacity: 0.95;
    font-size: 1rem;
  }
  .tour-cta-button {
    display: inline-block;
    background: #fff;
    color: var(--burnt-orange, #d4764e);
    font-weight: 700;
    padding: 14px 32px;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .tour-cta-button:hover { transform: scale(1.04); }
</style>
