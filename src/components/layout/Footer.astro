---
// Footer.astro — reusable, configurable footer (Build Guide §3.1, §2.2).
//
// The 16 legacy "full" footers diverged organically across the site (each
// page ships different link columns, contact formatting, and copyright
// text — see PROJECT_STATE.md "Open Decisions" for the cozelosdata.com vs.
// Adventure Tours Vernal copyright question, which remains unresolved).
// Rather than silently normalizing that content during a foundation-only
// phase, this component makes every one of those differences an explicit
// prop, so each page's exact current output is reproduced through
// configuration instead of duplicated markup. Ten "spoke" article pages
// already share one identical compact footer — use variant="compact" for
// those with no props needed.
//
// LINK CONVENTION (Phase-gate correction #1 + G2): every href this
// component emits is ROOT-RELATIVE in the directory-URL form ('/faq/').
// Pages that pass custom trails/info/columns links MUST do the same —
// never relative, never .html.
import { SITE } from '../../config/site';
import { getLangFromUrl, localeHref } from '../../lib/i18n';
import { t } from '../../lib/ui';
// AR-2 B-2. The footer phone is the second of the two runs the census measured still bare
// on the Arabic page. All three `phoneDisplay` sites below are migrated, not just the one
// that renders there today: they are one shared source rendered by three branches of one
// component, and isolating the measured branch alone would leave the other two to be
// rediscovered the first time a different Arabic page picks a different footer variant.
import Bidi from '../Bidi.astro';

interface LinkItem { href: string; label: string; class?: string }
interface FooterColumn { heading: string; links: LinkItem[] }
interface ContactConfig {
  heading?: string;
  showStreet?: boolean;
  phoneFormat?: 'dash' | 'plus';
  emailAsLink?: boolean;
  showHours?: boolean;
}

interface Props {
  variant?: 'full' | 'compact';
  showSocial?: boolean;
  tagline?: string;
  logoHeight?: number;
  /** Show the phone directly in the brand column (best-restaurants style). */
  brandPhone?: boolean;
  /** Default two-column layout: trail links + information links. */
  trails?: { heading: string; links: LinkItem[] };
  contact?: ContactConfig | false;
  info?: { heading: string; links: LinkItem[]; secondHeading?: string; secondLinks?: LinkItem[] };
  /** Fully generic columns — overrides trails/info when provided. */
  columns?: FooterColumn[];
  copyright?: { prefix?: string; linkText?: string; linkHref?: string; suffix?: string };
}

const lang = getLangFromUrl(Astro.url);
// Existence-aware hrefs (localeHref): keep the reader in their locale where
// the page is translated, fall back to English where it is not. Same rule the
// nav follows — chrome links must never silently reset the chosen language.
const fh = (slug: string) => localeHref(slug, lang);
const bookingHref = fh('booking');
// Each trail links to its own section on the trail-systems page (ADR-12).
// These five fragments were dead for the whole corpus as `/#tours`: the home
// route resolved, the fragment never existed on any page in any locale. A
// route-existence check and a fragment-existence check are different questions
// — gate 4s (`scripts/gate-4s-fragments.mjs`) now answers the second.
const trailsPage = fh('utv/best-utv-trails-vernal');
const trailHref = (frag: string) => `${trailsPage}#${frag}`;
const {
  variant = 'full',
  showSocial = true,
  tagline = t('footer.tagline', lang),
  logoHeight,
  brandPhone = false,
  trails = {
    heading: t('footer.ourTrails', lang),
    // Trail names are place names — kept verbatim, never translated.
    links: [
      { href: trailHref('1-docs-beach'), label: "Doc's Beach" },
      { href: trailHref('2-moonshine-arch'), label: 'Moonshine Arch' },
      { href: trailHref('3-ashley-gorge'), label: 'Ashley Gorge' },
      { href: trailHref('4-outlaw-trail'), label: 'Outlaw Trail' },
      { href: trailHref('5-asphalt-ridge'), label: 'Asphalt Ridge' },
      { href: bookingHref, label: t('cta.bookNow', lang), class: 'nav-book-btn' },
    ],
  },
  contact = {},
  info = {
    heading: t('footer.information', lang),
    links: [
      { href: fh('cancellation-policy'), label: t('nav.cancellationPolicy', lang) },
      { href: fh('privacy-policy'), label: t('nav.privacyPolicy', lang) },
      { href: fh('faq'), label: t('nav.faq', lang) },
      { href: fh('safety-guidelines'), label: t('nav.safetyGuidelines', lang) },
      { href: fh('guides/what-to-bring'), label: t('nav.whatToBring', lang) },
    ],
    // Active authority hubs (Task 3, Build Guide §2.2) — the default
    // footer's second column, so every collection spoke page (SpokeLayout
    // renders a bare <Footer /> with no props) links out to every hub.
    secondHeading: t('section.exploreVernal', lang),
    secondLinks: [
      { href: fh('utv'), label: t('footer.link.utvTrailsTours', lang) },
      { href: fh('things-to-do'), label: t('footer.link.thingsToDo', lang) },
      { href: fh('dinosaur-national-monument'), label: t('footer.link.dinosaurNationalMonument', lang) },
      { href: fh('guides'), label: t('footer.link.guides', lang) },
      { href: fh('from/salt-lake-city'), label: t('footer.link.visitingFromSLC', lang) },
    ],
  },
  columns,
  copyright = {},
} = Astro.props;

const copyrightConfig = {
  prefix: '',
  linkText: 'cozelosdata.com',
  linkHref: 'https://cozelosdata.com',
  suffix: t('footer.copyrightSuffix', lang),
  ...copyright,
};

const contactConfig: ContactConfig | false = contact === false ? false : {
  heading: t('footer.contactInfo', lang),
  showStreet: true,
  phoneFormat: 'dash',
  emailAsLink: false,
  showHours: true,
  ...contact,
};
const phoneHref = contactConfig && contactConfig.phoneFormat === 'plus' ? SITE.phoneHrefPlus : SITE.phoneHrefDash;
---
{variant === 'compact' ? (
  <footer style="background:var(--charcoal);color:rgba(255,255,255,0.6);text-align:center;padding:30px 20px;font-size:0.9rem;">
    <p>&copy; 2026 {SITE.name} &middot; <a href={fh('privacy-policy')} style="color:var(--burnt-orange);">{t('nav.privacyPolicy', lang)}</a> &middot; <a href={fh('cancellation-policy')} style="color:var(--burnt-orange);">{t('nav.cancellationPolicy', lang)}</a></p>
    <p style="margin-top:8px;">{`${SITE.address.street}, ${SITE.address.city}, ${SITE.address.region} ${SITE.address.postalCode}`} &middot; <a href={SITE.phoneHrefDash} style="color:var(--burnt-orange);"><Bidi>{SITE.phoneDisplay}</Bidi></a></p>
  </footer>
) : (
  <footer>
    <div class="footer-content">
      <div class="footer-section">
        <div class="footer-logo">
          <img src="/images/logo.webp" alt={SITE.name} height={logoHeight}>
        </div>
        <p>{tagline}</p>
        {brandPhone && (
          <div class="footer-phone-highlight"><a href={SITE.phoneHrefPlus} class="footer-phone-link">&#128222; <Bidi>{SITE.phoneDisplay}</Bidi></a></div>
        )}
        {showSocial && (
          <div class="social-links">
            <a href="#" class="social-link" aria-label="Facebook">&#128280;</a>
            <a href="#" class="social-link" aria-label="Instagram">&#128247;</a>
            <a href="#" class="social-link" aria-label="YouTube">&#127909;</a>
          </div>
        )}
      </div>

      {columns ? (
        columns.map((col) => (
          <div class="footer-section">
            <h4>{col.heading}</h4>
            <ul class="footer-links">
              {col.links.map((l) => <li><a href={l.href} class={l.class}>{l.label}</a></li>)}
            </ul>
          </div>
        ))
      ) : (
        <div class="footer-section">
          <h4>{trails.heading}</h4>
          <ul class="footer-links">
            {trails.links.map((l) => <li><a href={l.href} class={l.class}>{l.label}</a></li>)}
          </ul>
        </div>
      )}

      {contactConfig && (
        <div class="footer-section">
          <h4>{contactConfig.heading}</h4>
          <p>&#128205; {`${contactConfig.showStreet ? `${SITE.address.street}, ` : ''}${SITE.address.city}, ${SITE.address.region === 'UT' ? 'Utah' : SITE.address.region} ${SITE.address.postalCode}`}</p>
          <p class="footer-phone-highlight">
            <a href={phoneHref} class="footer-phone-link">&#128222; <Bidi>{SITE.phoneDisplay}</Bidi></a>
          </p>
          <p>&#9993;&#65039; {contactConfig.emailAsLink ? <a href={`mailto:${SITE.email}`}>{SITE.email}</a> : SITE.email}</p>
          {contactConfig.showHours && <p>&#8987; {SITE.hoursDisplay}</p>}
        </div>
      )}

      {!columns && (
        <div class="footer-section">
          <h4>{info.heading}</h4>
          <ul class="footer-links">
            {info.links.map((l) => <li><a href={l.href} class={l.class}>{l.label}</a></li>)}
          </ul>
          {info.secondHeading && info.secondLinks && (
            <Fragment>
              <h4 style="margin-top:18px;">{info.secondHeading}</h4>
              <ul class="footer-links">
                {info.secondLinks.map((l) => <li><a href={l.href} class={l.class}>{l.label}</a></li>)}
              </ul>
            </Fragment>
          )}
        </div>
      )}
    </div>
    <div class="footer-bottom">
      <p>&copy; {copyrightConfig.prefix}{copyrightConfig.linkHref ? <a href={copyrightConfig.linkHref} target="_blank">{copyrightConfig.linkText}</a> : copyrightConfig.linkText}{copyrightConfig.suffix}</p>
    </div>
  </footer>
)}
