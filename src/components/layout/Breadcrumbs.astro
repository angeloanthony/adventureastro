---
// Breadcrumbs.astro — visible trail + BreadcrumbList schema from one
// source, so the two can never drift (Build Guide §2.2, §5.6).
//
// `schemaOnly` emits just the BreadcrumbList JSON-LD and no visible markup:
// used on legacy pages that already ship their own styled `.article-breadcrumb`
// trail, so they gain the structured data without a duplicate visible trail.
import { absoluteUrl } from '../../lib/urls';
import { getLangFromUrl, localeHref, LOCALE_CODES } from '../../lib/i18n';
import { t } from '../../lib/ui';

// Crumb hrefs should be ROOT-RELATIVE ('/utv/') so the visible trail
// works from nested routes; absoluteUrl() normalizes either form for the
// JSON-LD, so legacy root-level callers keep byte-identical schema output.
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[]; schemaOnly?: boolean }
const { items, schemaOnly = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);

// The Home node belongs to this component: emitted once, in the reader's
// language, and existence-aware (localeHref falls back to '/' for a locale
// with no home page yet). A caller that ALSO passes a Home crumb — the spoke
// and itinerary routers did — otherwise rendered `Home > Home > ...` with the
// first link dropping localized readers onto the English homepage. Drop a
// leading crumb that is itself a home path rather than trusting 140+ callers.
const homeHref = localeHref('', lang);
const HOME_PATHS = new Set(['/', ...LOCALE_CODES.map((code) => `/${code}/`)]);
const crumbs = items[0]?.href && HOME_PATHS.has(items[0].href) ? items.slice(1) : items;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('nav.home', lang), item: absoluteUrl(homeHref) },
    ...crumbs.map((crumb, i) => ({
      '@type': 'ListItem',
      position: i + 2,
      name: crumb.label,
      ...(crumb.href ? { item: absoluteUrl(crumb.href) } : {}),
    })),
  ],
};
---
{!schemaOnly && (
  <nav class="breadcrumbs" aria-label={t('a11y.breadcrumb', lang)}>
    <a href={homeHref}>{t('nav.home', lang)}</a>
    {crumbs.map((crumb) => (
      <Fragment>
        <span class="sep">&rsaquo;</span>
        {crumb.href ? <a href={crumb.href}>{crumb.label}</a> : <span aria-current="page">{crumb.label}</span>}
      </Fragment>
    ))}
  </nav>
)}
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

<style>
  .breadcrumbs {
    max-width: 1200px;
    margin: 0 auto;
    padding: 16px 20px;
    font-size: 0.9rem;
    color: var(--charcoal, #333);
  }
  .breadcrumbs a {
    color: var(--burnt-orange, #d4764e);
    text-decoration: none;
  }
  .breadcrumbs a:hover { text-decoration: underline; }
  .breadcrumbs .sep { margin: 0 8px; color: rgba(0, 0, 0, 0.4); }
  .breadcrumbs [aria-current='page'] { color: rgba(0, 0, 0, 0.6); }
</style>
