---
// Header.astro — canonical site navigation (Build Guide §3.1).
// Markup is lifted verbatim from the legacy per-page navs, which are
// byte-identical across all 28 pages except which link carries the
// `active` state. Reads phone from SITE (§3.3) instead of hardcoding it.
// All hrefs are ROOT-RELATIVE (Phase-gate correction #1) so the nav works
// identically on nested hub/spoke routes.
import { SITE } from '../../config/site';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { getLangFromUrl, localeHref } from '../../lib/i18n';
import { t } from '../../lib/ui';

type ActiveKey = 'home' | 'about' | 'trails' | 'things-to-do' | 'dinosaur-national-monument' | 'guides' | 'food'
  | 'cancellation-policy' | 'privacy-policy' | 'faq' | 'safety-guidelines' | 'what-to-bring';
interface Props {
  active?: ActiveKey | '';
}
const { active = '' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
// Every nav href is existence-aware (localeHref): it stays in the reader's
// locale where that page is translated and falls back to English where it is
// not. Hardcoded '/about/'-style hrefs used to kick a non-English reader back
// to English on the first nav click, losing the language they had picked.
const nav = (slug: string) => localeHref(slug, lang);
const bookingHref = nav('booking');
---
<nav class="navbar">
  <div class="nav-container">
    <a href={nav('')} class="logo">
      <img src="/images/logo.webp" alt={`${SITE.name} Logo`}>
    </a>
    <ul class="nav-menu">
      <li><a href={nav('')} class:list={[{ active: active === 'home' }]}>{t('nav.home', lang)}</a></li>
      <li><a href={nav('about')} class:list={[{ active: active === 'about' }]}>{t('nav.about', lang)}</a></li>
      <li><a href={nav('utv')} class:list={[{ active: active === 'trails' }]}>{t('nav.trails', lang)}</a></li>
      <li><a href={nav('things-to-do')} class:list={[{ active: active === 'things-to-do' }]}>{t('nav.thingsToDo', lang)}</a></li>
      <li><a href={nav('dinosaur-national-monument')} class:list={[{ active: active === 'dinosaur-national-monument' }]}>{t('nav.dinosaurMonument', lang)}</a></li>
      <li><a href={nav('guides')} class:list={[{ active: active === 'guides' }]}>{t('nav.guides', lang)}</a></li>
      <li><a href={nav('things-to-do/best-restaurants-vernal-utah')} class:list={[{ active: active === 'food' }]}>{t('nav.food', lang)}</a></li>
      <li class="nav-dropdown">
        <a href="#" class="dropdown-toggle">{t('nav.info', lang)} &#9662;</a>
        <ul class="dropdown-menu">
          <li><a href={nav('cancellation-policy')} class:list={[{ active: active === 'cancellation-policy' }]}>{t('nav.cancellationPolicy', lang)}</a></li>
          <li><a href={nav('privacy-policy')} class:list={[{ active: active === 'privacy-policy' }]}>{t('nav.privacyPolicy', lang)}</a></li>
          <li><a href={nav('faq')} class:list={[{ active: active === 'faq' }]}>{t('nav.faq', lang)}</a></li>
          <li><a href={nav('safety-guidelines')} class:list={[{ active: active === 'safety-guidelines' }]}>{t('nav.safetyGuidelines', lang)}</a></li>
          <li><a href={nav('guides/what-to-bring')} class:list={[{ active: active === 'what-to-bring' }]}>{t('nav.whatToBring', lang)}</a></li>
        </ul>
      </li>
      <li><a href={SITE.phoneHrefDash} class="nav-phone">&#128222; {SITE.phoneDisplay}</a></li>
      <LanguageSwitcher />
      <li><a href={bookingHref} class="nav-book-btn">{t('cta.bookNow', lang)}</a></li>
    </ul>
    <button class="mobile-menu-toggle" aria-label={t('a11y.toggleMenu', lang)}>
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<script is:inline>
  document.querySelector('.mobile-menu-toggle')?.addEventListener('click', function () {
    const navMenu = document.querySelector('.nav-menu');
    if (!navMenu) return;
    if (navMenu.style.display === 'flex') {
      navMenu.style.display = 'none';
    } else {
      navMenu.style.display = 'flex';
      navMenu.style.flexDirection = 'column';
      navMenu.style.position = 'absolute';
      navMenu.style.top = '100%';
      navMenu.style.left = '0';
      navMenu.style.right = '0';
      navMenu.style.background = 'var(--off-white)';
      navMenu.style.padding = '20px';
      navMenu.style.boxShadow = '0 5px 20px rgba(0,0,0,0.1)';
    }
  });
  document.addEventListener('DOMContentLoaded', function () {
    const dropdownToggle = document.querySelector('.dropdown-toggle');
    const navDropdown = document.querySelector('.nav-dropdown');
    if (dropdownToggle && navDropdown) {
      dropdownToggle.addEventListener('click', function (e) {
        e.preventDefault();
        if (window.innerWidth <= 1280) navDropdown.classList.toggle('active');
      });
      document.addEventListener('click', function (e) {
        if (window.innerWidth <= 1280 && !navDropdown.contains(e.target)) {
          navDropdown.classList.remove('active');
        }
      });
      window.addEventListener('resize', function () {
        if (window.innerWidth > 1280) navDropdown.classList.remove('active');
      });
    }
  });
  window.addEventListener('scroll', () => {
    const navbar = document.querySelector('.navbar');
    if (!navbar) return;
    if (window.pageYOffset > 50) {
      navbar.style.boxShadow = '0 6px 40px rgba(0,0,0,0.12), 0 2px 10px rgba(212,118,78,0.08)';
      navbar.style.borderBottomColor = 'rgba(212,118,78,0.15)';
    } else {
      navbar.style.boxShadow = '0 4px 30px rgba(0,0,0,0.08), 0 2px 10px rgba(212,118,78,0.05)';
      navbar.style.borderBottomColor = 'transparent';
    }
  });
</script>
