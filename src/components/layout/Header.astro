---
// Header.astro — canonical site navigation (Build Guide §3.1).
// Markup is lifted verbatim from the legacy per-page navs, which are
// byte-identical across all 28 pages except which link carries the
// `active` state. Reads phone from SITE (§3.3) instead of hardcoding it.
// All hrefs are ROOT-RELATIVE (Phase-gate correction #1) so the nav works
// identically on nested hub/spoke routes.
import { SITE } from '../../config/site';

type ActiveKey = 'home' | 'about' | 'trails' | 'food'
  | 'cancellation-policy' | 'privacy-policy' | 'faq' | 'safety-guidelines' | 'what-to-bring';
interface Props {
  active?: ActiveKey | '';
}
const { active = '' } = Astro.props;
---
<nav class="navbar">
  <div class="nav-container">
    <a href="/" class="logo">
      <img src="/images/logo.webp" alt={`${SITE.name} Logo`}>
    </a>
    <ul class="nav-menu">
      <li><a href="/" class:list={[{ active: active === 'home' }]}>Home</a></li>
      <li><a href="/about/" class:list={[{ active: active === 'about' }]}>About</a></li>
      <li><a href="/utv/" class:list={[{ active: active === 'trails' }]}>Trails</a></li>
      <li><a href="/things-to-do/best-restaurants-vernal-utah/" class:list={[{ active: active === 'food' }]}>Food</a></li>
      <li class="nav-dropdown">
        <a href="#" class="dropdown-toggle">Info &#9662;</a>
        <ul class="dropdown-menu">
          <li><a href="/cancellation-policy/" class:list={[{ active: active === 'cancellation-policy' }]}>Cancellation Policy</a></li>
          <li><a href="/privacy-policy/" class:list={[{ active: active === 'privacy-policy' }]}>Privacy Policy</a></li>
          <li><a href="/faq/" class:list={[{ active: active === 'faq' }]}>FAQ</a></li>
          <li><a href="/safety-guidelines/" class:list={[{ active: active === 'safety-guidelines' }]}>Safety Guidelines</a></li>
          <li><a href="/guides/what-to-bring/" class:list={[{ active: active === 'what-to-bring' }]}>What to Bring</a></li>
        </ul>
      </li>
      <li><a href={SITE.phoneHrefDash} class="nav-phone">&#128222; {SITE.phoneDisplay}</a></li>
      <li><a href="/booking/" class="nav-book-btn">Book Now</a></li>
    </ul>
    <button class="mobile-menu-toggle" aria-label="Toggle menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<script is:inline>
  document.querySelector('.mobile-menu-toggle')?.addEventListener('click', function () {
    const navMenu = document.querySelector('.nav-menu');
    if (!navMenu) return;
    if (navMenu.style.display === 'flex') {
      navMenu.style.display = 'none';
    } else {
      navMenu.style.display = 'flex';
      navMenu.style.flexDirection = 'column';
      navMenu.style.position = 'absolute';
      navMenu.style.top = '100%';
      navMenu.style.left = '0';
      navMenu.style.right = '0';
      navMenu.style.background = 'var(--off-white)';
      navMenu.style.padding = '20px';
      navMenu.style.boxShadow = '0 5px 20px rgba(0,0,0,0.1)';
    }
  });
  document.addEventListener('DOMContentLoaded', function () {
    const dropdownToggle = document.querySelector('.dropdown-toggle');
    const navDropdown = document.querySelector('.nav-dropdown');
    if (dropdownToggle && navDropdown) {
      dropdownToggle.addEventListener('click', function (e) {
        e.preventDefault();
        if (window.innerWidth <= 768) navDropdown.classList.toggle('active');
      });
      document.addEventListener('click', function (e) {
        if (window.innerWidth <= 768 && !navDropdown.contains(e.target)) {
          navDropdown.classList.remove('active');
        }
      });
      window.addEventListener('resize', function () {
        if (window.innerWidth > 768) navDropdown.classList.remove('active');
      });
    }
  });
  window.addEventListener('scroll', () => {
    const navbar = document.querySelector('.navbar');
    if (!navbar) return;
    if (window.pageYOffset > 50) {
      navbar.style.boxShadow = '0 6px 40px rgba(0,0,0,0.12), 0 2px 10px rgba(212,118,78,0.08)';
      navbar.style.borderBottomColor = 'rgba(212,118,78,0.15)';
    } else {
      navbar.style.boxShadow = '0 4px 30px rgba(0,0,0,0.08), 0 2px 10px rgba(212,118,78,0.05)';
      navbar.style.borderBottomColor = 'transparent';
    }
  });
</script>
